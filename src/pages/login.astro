---
import Base from "../layouts/Base.astro";
const isDev = import.meta.env.DEV;
---

<Base title="BLS Cotizador — Iniciar Sesión">
  <div class="auth-shell">

    <!-- ── Brand panel ── -->
    <aside class="brand-panel">
      <div class="brand-rings" aria-hidden="true">
        <svg viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="core-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"   stop-color="#3b82f6" stop-opacity="0.22"/>
              <stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="mid-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"   stop-color="#3b82f6" stop-opacity="0.08"/>
              <stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <!-- Outer ring -->
          <circle cx="240" cy="240" r="220" stroke="#3b82f6" stroke-opacity="0.06" stroke-width="1"/>
          <!-- Mid rings -->
          <circle cx="240" cy="240" r="175" stroke="#3b82f6" stroke-opacity="0.10" stroke-width="1"/>
          <circle cx="240" cy="240" r="130" stroke="#3b82f6" stroke-opacity="0.16" stroke-width="1"/>
          <!-- Inner -->
          <circle cx="240" cy="240" r="85"  stroke="#3b82f6" stroke-opacity="0.28" stroke-width="1.5"/>
          <!-- Glows -->
          <circle cx="240" cy="240" r="130" fill="url(#mid-glow)"/>
          <circle cx="240" cy="240" r="85"  fill="url(#core-glow)"/>
          <!-- Accent dots -->
          <circle cx="240" cy="20"  r="3" fill="#3b82f6" fill-opacity="0.4"/>
          <circle cx="460" cy="240" r="3" fill="#3b82f6" fill-opacity="0.4"/>
          <circle cx="240" cy="460" r="3" fill="#3b82f6" fill-opacity="0.25"/>
          <circle cx="20"  cy="240" r="3" fill="#3b82f6" fill-opacity="0.25"/>
          <circle cx="414" cy="66"  r="2" fill="#3b82f6" fill-opacity="0.3"/>
          <circle cx="66"  cy="414" r="2" fill="#3b82f6" fill-opacity="0.2"/>
        </svg>
      </div>

      <div class="brand-content">
        <div class="brand-mark">
          <span class="brand-letter">B</span>
          <span class="brand-letter">L</span>
          <span class="brand-letter">S</span>
        </div>
        <p class="brand-name">Cotizador</p>
        <p class="brand-tagline">Sistema de cotizaciones para eventos audiovisuales</p>

        <ul class="brand-features">
          <li>
            <span class="feat-dot"></span>
            Cotizaciones profesionales en minutos
          </li>
          <li>
            <span class="feat-dot"></span>
            Seguimiento de clientes y estados
          </li>
          <li>
            <span class="feat-dot"></span>
            Dashboard con analíticas en tiempo real
          </li>
        </ul>
      </div>

      <p class="brand-footer">© {new Date().getFullYear()} BLS Producciones</p>
    </aside>

    <!-- ── Form panel ── -->
    <main class="form-panel">
      <div class="form-card">

        <header class="form-header">
          <div class="form-logo" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="14" cy="14" r="13" stroke="var(--accent)" stroke-width="1.5" stroke-opacity="0.4"/>
              <circle cx="14" cy="14" r="8"  fill="var(--accent)" fill-opacity="0.12"/>
              <circle cx="14" cy="14" r="4"  fill="var(--accent)"/>
            </svg>
          </div>
          <h1 class="form-title">Bienvenido de nuevo</h1>
          <p class="form-subtitle">Ingresá tus credenciales para continuar</p>
        </header>

        <form id="login-form" class="form-body" novalidate>
          <div class="field-group">
            <label class="field-label" for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="tu@email.com"
              class="field"
              required
            />
          </div>

          <div class="field-group">
            <div class="field-label-row">
              <label class="field-label" for="password">Contraseña</label>
              <a href="/forgot-password" class="field-link">¿Olvidaste tu contraseña?</a>
            </div>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="••••••••"
              class="field"
              required
            />
          </div>

          <div id="error-banner" class="error-banner hidden">
            <span class="material-symbols-rounded ms-sm">error</span>
            <span id="error-text">Credenciales inválidas.</span>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-primary submit-btn">
            <span id="btn-label">Iniciar sesión</span>
            <span id="btn-spinner" class="spinner hidden" aria-hidden="true"></span>
          </button>
        </form>

        {isDev && (
          <div id="dev-hint" class="dev-hint" title="Click para autocompletar">
            <span class="material-symbols-rounded ms-sm">terminal</span>
            <span><strong>Dev:</strong> demo@bls.com.ar / demo123</span>
          </div>
        )}

      </div>
    </main>
  </div>
</Base>

<script>
  import { authService, getIdToken, establishServerSession } from "../utils/auth";
  import { notifications } from "../utils/notifications.js";
  import { ValidationHelper } from "../utils/validationHelpers";

  authService.isAuthenticated().then((ok) => { if (ok) window.location.href = "/dashboard"; });

  const form   = document.getElementById("login-form") as HTMLFormElement;
  const btn    = document.getElementById("submit-btn") as HTMLButtonElement;
  const label  = document.getElementById("btn-label")!;
  const spinner = document.getElementById("btn-spinner")!;
  const banner = document.getElementById("error-banner")!;
  const errTxt = document.getElementById("error-text")!;

  function setLoading(on: boolean) {
    btn.disabled = on;
    label.textContent = on ? "Verificando…" : "Iniciar sesión";
    spinner.classList.toggle("hidden", !on);
  }

  function showError(msg: string) {
    errTxt.textContent = msg;
    banner.classList.remove("hidden");
  }

  function clearError() { banner.classList.add("hidden"); }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearError();

    const fd = new FormData(form);
    const email = (fd.get("email") as string)?.trim();
    const password = fd.get("password") as string;

    const v = ValidationHelper.validateLogin({ email, password });
    if (!v.isValid) { showError(v.errors.join(" ")); return; }

    setLoading(true);
    try {
      const { user, error } = await authService.signIn(email, password);
      if (error) throw new Error(error.message);
      if (user) {
        const idToken = await getIdToken();
        if (!idToken) {
          showError("No se pudo obtener el token de sesión. Intentá de nuevo.");
          return;
        }
        try {
          await establishServerSession(idToken);
        } catch {
          showError("No se pudo iniciar sesión. Intentá de nuevo.");
          return;
        }
        notifications.success("¡Bienvenido!", "Redirigiendo…");
        setTimeout(() => window.location.href = "/dashboard", 900);
      }
    } catch (err) {
      const code = err instanceof Error ? err.message : "";
      let msg = "Error de autenticación. Verificá tus credenciales.";
      if (code.includes("invalid-credential") || code.includes("user-not-found")) msg = "Email o contraseña incorrectos.";
      else if (code.includes("user-disabled")) msg = "Esta cuenta fue deshabilitada.";
      else if (code.includes("too-many-requests")) msg = "Demasiados intentos. Intentá más tarde.";
      else if (code.includes("network-request-failed")) msg = "Sin conexión. Verificá tu internet.";
      showError(msg);
    } finally {
      setLoading(false);
    }
  });

  // Dev hint autofill
  document.getElementById("dev-hint")?.addEventListener("click", () => {
    (document.getElementById("email") as HTMLInputElement).value = "demo@bls.com.ar";
    (document.getElementById("password") as HTMLInputElement).value = "demo123";
  });
</script>

<style>
  /* ── Shell ── */
  .auth-shell {
    min-height: 100vh;
    display: flex;
  }

  /* ── Brand panel ── */
  .brand-panel {
    display: none;
    position: relative;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    padding: 48px 52px;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--line);
  }
  @media (min-width: 1024px) { .brand-panel { display: flex; width: 44%; } }

  .brand-rings {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .brand-rings svg { width: 520px; height: 520px; opacity: 0.9; }

  .brand-content {
    position: relative;
    z-index: 1;
    margin-top: auto;
    margin-bottom: auto;
  }

  .brand-mark {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
  }
  .brand-letter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: rgba(59,130,246,0.10);
    border: 1px solid rgba(59,130,246,0.22);
    font-size: 26px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
    font-family: 'Inter', sans-serif;
    box-shadow: 0 0 20px rgba(59,130,246,0.10);
  }

  .brand-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .brand-tagline {
    font-size: 15px;
    color: var(--ink-mute);
    line-height: 1.5;
    max-width: 280px;
    margin-bottom: 36px;
  }

  .brand-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .brand-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-mute);
  }
  .feat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 8px var(--accent);
  }

  .brand-footer {
    position: relative;
    z-index: 1;
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.03em;
  }

  /* ── Form panel ── */
  .form-panel {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    background: var(--bg);
  }

  .form-card {
    width: 100%;
    max-width: 360px;
    animation: authSlide 320ms cubic-bezier(.2,.7,.1,1) both;
  }

  @keyframes authSlide {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Form header ── */
  .form-header {
    margin-bottom: 36px;
  }
  .form-logo {
    margin-bottom: 20px;
  }
  .form-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }
  .form-subtitle {
    font-size: 13px;
    color: var(--ink-mute);
  }

  /* ── Form body ── */
  .form-body { display: flex; flex-direction: column; gap: 20px; }

  .field-group { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
  }
  .field-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .field-link {
    font-size: 11.5px;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 150ms;
  }
  .field-link:hover { opacity: 0.75; }

  /* ── Error banner ── */
  .error-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(248,113,113,0.07);
    border: 1px solid rgba(248,113,113,0.20);
    border-radius: 6px;
    font-size: 13px;
    color: #fca5a5;
  }
  .error-banner.hidden { display: none; }

  /* ── Submit button ── */
  .submit-btn {
    width: 100%;
    height: 40px;
    justify-content: center;
    font-size: 13.5px;
    font-weight: 600;
    margin-top: 4px;
  }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  /* ── Spinner ── */
  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(241,246,255,0.25);
    border-top-color: #f1f6ff;
    border-radius: 50%;
    animation: spin 600ms linear infinite;
    margin-left: 6px;
  }
  .spinner.hidden { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Dev hint ── */
  .dev-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 10px 12px;
    background: rgba(59,130,246,0.05);
    border: 1px solid rgba(59,130,246,0.15);
    border-radius: 6px;
    font-size: 12px;
    color: var(--ink-mute);
    cursor: pointer;
    transition: background 150ms;
  }
  .dev-hint:hover { background: rgba(59,130,246,0.09); }
</style>
