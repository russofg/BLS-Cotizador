---
import DashboardLayout from "../layouts/Dashboard.astro";
import ScrollbarStyles from "../components/ScrollbarStyles.astro";
import { DateHelper } from "../utils/dateHelpers";
import { QuoteHelper } from "../utils/quoteHelpers";

// Load analytics data
let analytics: any = null;
let stats: {
  totalCotizaciones: number;
  cotizacionesPendientes: number;
  itemsActivos: number;
  totalClientes: number;
  cotizacionesRecientes: any[];
} = {
  totalCotizaciones: 0,
  cotizacionesPendientes: 0,
  itemsActivos: 0,
  totalClientes: 0,
  cotizacionesRecientes: [],
};

// Try to load analytics and stats, but fail gracefully
try {
  const { AnalyticsService } = await import("../services/AnalyticsService");
  analytics = await AnalyticsService.getDashboardAnalytics();
  
  // Update stats with analytics data
  stats = {
    totalCotizaciones: analytics.quotes.totalQuotes,
    cotizacionesPendientes: analytics.quotes.quotesByStatus.find((s: any) => s.status === 'Pendiente')?.count || 0,
    itemsActivos: analytics.items.activeItems,
    totalClientes: analytics.clients.totalClients,
    cotizacionesRecientes: analytics.recentQuotes || [],
  };
} catch (error) {
  try {
    const { statsService } = await import("../utils/database");
    stats = await statsService.getDashboardStats();
  } catch (fallbackError) {
    // Keep default stats
  }
}
---

<DashboardLayout title="Dashboard - BLS Cotizador" activeSection="dashboard">
  <ScrollbarStyles />

  <div class="page-enter p-4 sm:p-8 space-y-4 w-full max-w-full">

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-[22px] font-semibold tracking-tightest text-ink">Dashboard</h1>
        <p class="text-[13px] text-ink-mute mt-0.5">
          Rendimiento de operaciones · {new Date().toLocaleDateString('es-AR', {weekday:'long', day:'numeric', month:'long'})}
        </p>
      </div>
      <div class="flex gap-2">
        <button class="btn btn-ghost btn-sm">
          <span class="material-symbols-rounded">download</span>
          Exportar
        </button>
        <button class="btn btn-primary btn-sm">
          <span class="material-symbols-rounded">refresh</span>
          Actualizar
        </button>
      </div>
    </div>

    <!-- Bento stats: 4 cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">

      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Cotizaciones Totales</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-ink">{stats.totalCotizaciones}</div>
        <div class="mt-2 text-[11.5px] text-ink-mute">propuestas generadas</div>
      </div>

      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Pendientes</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-warn">{stats.cotizacionesPendientes}</div>
        <div class="mt-2 text-[11.5px] text-ink-mute">acción requerida</div>
      </div>

      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Ítems Activos</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-ok">{stats.itemsActivos}</div>
        <div class="mt-2 text-[11.5px] text-ink-mute">en catálogo general</div>
      </div>

      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Clientes Totales</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-ink">{stats.totalClientes}</div>
        <div class="mt-2 text-[11.5px] text-ink-mute">en el directorio</div>
      </div>

    </div>

    <!-- Fila principal: gráfico 8 cols + categorías 4 cols -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-3">

      <!-- Gráfico de barras mensual -->
      <div class="surface p-5 lg:col-span-2 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-[13px] font-semibold tracking-tight text-ink">Rendimiento de Cotizaciones</h2>
          <span class="badge badge-neutral"><span class="dot"></span>6 meses</span>
        </div>

        {analytics ? (
          <div class="space-y-3">
            <div class="h-48 flex items-end justify-between gap-2 px-2 w-full">
              {analytics.quotes.quotesByMonth.slice(-6).map((month: any, idx: number) => {
                const maxCount = Math.max(...analytics.quotes.quotesByMonth.map((m: any) => m.count));
                const percentage = Math.max(8, Math.floor((month.count / maxCount) * 100));
                const isLast = idx === analytics.quotes.quotesByMonth.slice(-6).length - 1;
                return (
                  <div class="relative w-full group flex flex-col items-center justify-end h-full">
                    <div
                      class={`w-full rounded-t transition-colors cursor-pointer ${isLast ? 'bg-accent' : 'bg-bg-sunken hover:bg-accent/40'}`}
                      style={`height: ${percentage}%`}
                    >
                      <div class={`absolute -top-7 left-1/2 -translate-x-1/2 bg-ink text-bg text-[10px] px-1.5 py-0.5 rounded pointer-events-none transition-opacity ${isLast ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'}`}>
                        {month.count}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
            <div class="flex justify-between text-[10px] text-ink-faint uppercase tracking-[0.08em] px-2">
              {analytics.quotes.quotesByMonth.slice(-6).map((month: any) => (
                <span>{new Date(month.month + '-01').toLocaleDateString('es-ES', { month: 'short' }).substring(0, 3)}</span>
              ))}
            </div>
          </div>
        ) : (
          <div class="h-48 flex items-center justify-center border border-dashed border-line rounded">
            <p class="text-[13px] text-ink-faint">Cargando métricas...</p>
          </div>
        )}
      </div>

      <!-- Categorías -->
      <div class="surface p-5 flex flex-col justify-between gap-6">
        <div>
          <h2 class="text-[13px] font-semibold tracking-tight text-ink mb-4">Por categoría</h2>
          <div class="space-y-4">
            {analytics ? (() => {
              const totalItemsCount = analytics.items.itemsByCategory.reduce((acc: number, c: any) => acc + c.count, 0);
              const topCategories = analytics.items.itemsByCategory.slice(0, 4);
              return topCategories.map((category: any) => {
                const percentage = totalItemsCount > 0 ? Math.round((category.count / totalItemsCount) * 100) : 0;
                return (
                  <div class="space-y-1.5">
                    <div class="flex justify-between text-[11px]">
                      <span class="text-ink-mute truncate pr-3">{category.category}</span>
                      <span class="text-ink num">{percentage}%</span>
                    </div>
                    <div class="h-1 w-full bg-bg-sunken rounded-full overflow-hidden">
                      <div class="h-full bg-accent rounded-full" style={`width: ${percentage}%`}></div>
                    </div>
                  </div>
                );
              });
            })() : (
              <p class="text-[12px] text-ink-faint">Cargando...</p>
            )}
          </div>
        </div>
        <a href="/items" class="btn btn-ghost btn-sm w-full justify-center">
          Ver reporte de ítems
        </a>
      </div>

    </div>

    <!-- Cotizaciones recientes -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-3">

      <div class="surface overflow-hidden lg:col-span-3">
        <div class="px-5 py-4 border-b border-line flex items-center justify-between">
          <h2 class="text-[13px] font-semibold tracking-tight text-ink">Cotizaciones Recientes</h2>
          <a href="/quotes" class="text-[11px] text-accent flex items-center gap-0.5 hover:underline">
            Ver todo <span class="material-symbols-rounded text-[14px]">chevron_right</span>
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="tbl">
            <thead>
              <tr>
                <th>ID Cotización</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Estado</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {stats.cotizacionesRecientes.length > 0 ? stats.cotizacionesRecientes.slice(0, 5).map((cotizacion: any) => {
                const normStatus = QuoteHelper.normalizeQuoteStatus(cotizacion.estado);
                let badgeClass = "badge-neutral";
                let statusText = "Borrador";
                if (normStatus === 'aprobada')   { badgeClass = "badge-ok";     statusText = "Aprobada"; }
                else if (normStatus === 'enviada')    { badgeClass = "badge-accent"; statusText = "Enviada"; }
                else if (normStatus === 'rechazada')  { badgeClass = "badge-err";    statusText = "Rechazada"; }
                else if (normStatus === 'pendiente')  { badgeClass = "badge-warn";   statusText = "Pendiente"; }
                else if (normStatus === 'convertida') { badgeClass = "badge-accent"; statusText = "Facturada"; }
                return (
                  <tr class="row">
                    <td>
                      <a href={`/quotes/view/${cotizacion.id}`} class="num text-[11px] text-accent hover:underline">
                        {QuoteHelper.getDisplayQuoteNumber(cotizacion)}
                      </a>
                    </td>
                    <td>
                      <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded bg-bg-sunken flex items-center justify-center text-[10px] font-semibold text-ink-mute">
                          {cotizacion.cliente?.nombre?.substring(0, 2).toUpperCase() || "CL"}
                        </div>
                        <span class="text-[13px] text-ink">{cotizacion.cliente?.nombre || "Cliente General"}</span>
                      </div>
                    </td>
                    <td class="text-[12px] text-ink-mute">
                      {new Date(cotizacion.fechaEmision || cotizacion.createdAt).toLocaleDateString("es-AR")}
                    </td>
                    <td class="num font-semibold text-ink">
                      ${cotizacion.total.toLocaleString("es-AR")}
                    </td>
                    <td>
                      <span class={`badge ${badgeClass}`}>
                        <span class="dot"></span>{statusText}
                      </span>
                    </td>
                    <td>
                      <a href={`/quotes/view/${cotizacion.id}`} class="btn btn-icon btn-quiet">
                        <span class="material-symbols-rounded">open_in_new</span>
                      </a>
                    </td>
                  </tr>
                );
              }) : (
                <tr>
                  <td class="text-ink-faint italic">No hay cotizaciones</td>
                  <td class="text-ink-faint text-[12px]" colspan="5">Sistema sincronizado, generá tu primera cotización.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Acciones rápidas -->
      <div class="surface p-5 space-y-4">
        <h2 class="text-[13px] font-semibold tracking-tight text-ink">Acciones Rápidas</h2>
        <div class="space-y-2">
          <a href="/clients" class="flex items-center gap-3 p-3 rounded border border-line hover:border-accent/40 hover:bg-accent-wash transition-all group">
            <span class="material-symbols-rounded text-accent text-[18px]">person_add</span>
            <span class="text-[13px] text-ink-mute group-hover:text-ink">Agregar Cliente</span>
            <span class="material-symbols-rounded text-[14px] text-ink-faint ml-auto">arrow_forward</span>
          </a>
          <a href="/items" class="flex items-center gap-3 p-3 rounded border border-line hover:border-accent/40 hover:bg-accent-wash transition-all group">
            <span class="material-symbols-rounded text-accent text-[18px]">add_box</span>
            <span class="text-[13px] text-ink-mute group-hover:text-ink">Crear Ítem</span>
            <span class="material-symbols-rounded text-[14px] text-ink-faint ml-auto">arrow_forward</span>
          </a>
          <a href="/config" class="flex items-center gap-3 p-3 rounded border border-line hover:border-accent/40 hover:bg-accent-wash transition-all group">
            <span class="material-symbols-rounded text-accent text-[18px]">settings</span>
            <span class="text-[13px] text-ink-mute group-hover:text-ink">Configuración</span>
            <span class="material-symbols-rounded text-[14px] text-ink-faint ml-auto">arrow_forward</span>
          </a>
          <a href="/quotes/wizard" class="btn btn-primary w-full justify-center mt-2">
            <span class="material-symbols-rounded">add_circle</span>
            Nueva Cotización
          </a>
        </div>
      </div>

    </div>

  </div>
</DashboardLayout>
