---
import Base from "../layouts/Base.astro";
---

<Base title="BLS Cotizador — Recuperar contraseña">
  <div class="auth-shell">

    <!-- ── Brand panel ── -->
    <aside class="brand-panel">
      <div class="brand-rings" aria-hidden="true">
        <svg viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="core-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"   stop-color="#3b82f6" stop-opacity="0.22"/>
              <stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="mid-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"   stop-color="#3b82f6" stop-opacity="0.08"/>
              <stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <circle cx="240" cy="240" r="220" stroke="#3b82f6" stroke-opacity="0.06" stroke-width="1"/>
          <circle cx="240" cy="240" r="175" stroke="#3b82f6" stroke-opacity="0.10" stroke-width="1"/>
          <circle cx="240" cy="240" r="130" stroke="#3b82f6" stroke-opacity="0.16" stroke-width="1"/>
          <circle cx="240" cy="240" r="85"  stroke="#3b82f6" stroke-opacity="0.28" stroke-width="1.5"/>
          <circle cx="240" cy="240" r="130" fill="url(#mid-glow)"/>
          <circle cx="240" cy="240" r="85"  fill="url(#core-glow)"/>
          <circle cx="240" cy="20"  r="3" fill="#3b82f6" fill-opacity="0.4"/>
          <circle cx="460" cy="240" r="3" fill="#3b82f6" fill-opacity="0.4"/>
          <circle cx="240" cy="460" r="3" fill="#3b82f6" fill-opacity="0.25"/>
          <circle cx="20"  cy="240" r="3" fill="#3b82f6" fill-opacity="0.25"/>
          <circle cx="414" cy="66"  r="2" fill="#3b82f6" fill-opacity="0.3"/>
          <circle cx="66"  cy="414" r="2" fill="#3b82f6" fill-opacity="0.2"/>
        </svg>
      </div>

      <div class="brand-content">
        <div class="brand-mark">
          <span class="brand-letter">B</span>
          <span class="brand-letter">L</span>
          <span class="brand-letter">S</span>
        </div>
        <p class="brand-name">Cotizador</p>
        <p class="brand-tagline">Recuperá el acceso a tu cuenta en segundos</p>

        <ul class="brand-features">
          <li><span class="feat-dot"></span>Ingresá tu email registrado</li>
          <li><span class="feat-dot"></span>Revisá tu bandeja de entrada</li>
          <li><span class="feat-dot"></span>Seguí el link para crear una nueva contraseña</li>
        </ul>
      </div>

      <p class="brand-footer">© {new Date().getFullYear()} BLS Producciones</p>
    </aside>

    <!-- ── Form panel ── -->
    <main class="form-panel">
      <div class="form-card">

        <!-- Default state: form -->
        <div id="view-form">
          <header class="form-header">
            <div class="form-icon" aria-hidden="true">
              <span class="material-symbols-rounded ms-xl">lock_reset</span>
            </div>
            <h1 class="form-title">Recuperar contraseña</h1>
            <p class="form-subtitle">
              Ingresá tu email y te mandamos un link para crear una nueva contraseña.
            </p>
          </header>

          <form id="fp-form" class="form-body" novalidate>
            <div class="field-group">
              <label class="field-label" for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="tu@email.com"
                class="field"
                required
              />
            </div>

            <div id="error-banner" class="error-banner hidden">
              <span class="material-symbols-rounded ms-sm">error</span>
              <span id="error-text">Ocurrió un error.</span>
            </div>

            <button type="submit" id="submit-btn" class="btn btn-primary submit-btn">
              <span id="btn-label">Enviar link de recuperación</span>
              <span id="btn-spinner" class="spinner hidden" aria-hidden="true"></span>
            </button>
          </form>
        </div>

        <!-- Success state -->
        <div id="view-success" class="hidden">
          <div class="success-icon" aria-hidden="true">
            <span class="material-symbols-rounded" style="font-size:40px;color:var(--ok)">mark_email_read</span>
          </div>
          <h1 class="form-title">Email enviado</h1>
          <p class="form-subtitle" style="margin-top:10px">
            Revisá tu bandeja de entrada. Si el email está registrado, vas a recibir
            las instrucciones para restablecer tu contraseña.
          </p>
          <p class="form-subtitle" style="margin-top:8px;font-size:12px;color:var(--ink-faint)">
            No olvides revisar la carpeta de spam.
          </p>
        </div>

        <!-- Back link (always visible) -->
        <a href="/login" class="back-link">
          <span class="material-symbols-rounded ms-sm">arrow_back</span>
          Volver al inicio de sesión
        </a>

      </div>
    </main>
  </div>
</Base>

<script>
  import { authService } from "../utils/auth";
  import { ValidationHelper } from "../utils/validationHelpers";

  const form    = document.getElementById("fp-form") as HTMLFormElement;
  const btn     = document.getElementById("submit-btn") as HTMLButtonElement;
  const label   = document.getElementById("btn-label")!;
  const spinner = document.getElementById("btn-spinner")!;
  const banner  = document.getElementById("error-banner")!;
  const errTxt  = document.getElementById("error-text")!;

  function setLoading(on: boolean) {
    btn.disabled = on;
    label.textContent = on ? "Enviando…" : "Enviar link de recuperación";
    spinner.classList.toggle("hidden", !on);
  }

  function showError(msg: string) {
    errTxt.textContent = msg;
    banner.classList.remove("hidden");
  }

  function showSuccess() {
    document.getElementById("view-form")!.classList.add("hidden");
    document.getElementById("view-success")!.classList.remove("hidden");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    banner.classList.add("hidden");

    const email = ((new FormData(form)).get("email") as string)?.trim();
    const v = ValidationHelper.validateEmail(email);
    if (!v.isValid) { showError(v.errors.join(" ")); return; }

    setLoading(true);
    try {
      const { success, error } = await authService.resetPassword(email);
      if (error) throw new Error(error.message);
      if (success) showSuccess();
    } catch (err) {
      const code = err instanceof Error ? err.message : "";
      let msg = "No se pudo enviar el email. Intentá de nuevo.";
      if (code.includes("user-not-found"))    msg = "No existe una cuenta con ese email.";
      else if (code.includes("invalid-email")) msg = "El formato del email no es válido.";
      else if (code.includes("too-many-requests")) msg = "Demasiados intentos. Esperá un momento.";
      showError(msg);
    } finally {
      setLoading(false);
    }
  });
</script>

<style>
  .auth-shell {
    min-height: 100vh;
    display: flex;
  }

  /* ── Brand panel ── (identical tokens to login) */
  .brand-panel {
    display: none;
    position: relative;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    padding: 48px 52px;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--line);
  }
  @media (min-width: 1024px) { .brand-panel { display: flex; width: 44%; } }

  .brand-rings {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none;
  }
  .brand-rings svg { width: 520px; height: 520px; opacity: 0.9; }

  .brand-content { position: relative; z-index: 1; margin: auto 0; }

  .brand-mark { display: flex; gap: 6px; margin-bottom: 16px; }
  .brand-letter {
    display: flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: 10px;
    background: rgba(59,130,246,0.10);
    border: 1px solid rgba(59,130,246,0.22);
    font-size: 26px; font-weight: 700; color: var(--accent);
    letter-spacing: -0.02em;
    box-shadow: 0 0 20px rgba(59,130,246,0.10);
  }
  .brand-name {
    font-size: 13px; font-weight: 500; color: var(--ink-mute);
    letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 8px;
  }
  .brand-tagline {
    font-size: 15px; color: var(--ink-mute); line-height: 1.5;
    max-width: 280px; margin-bottom: 36px;
  }
  .brand-features { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .brand-features li { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-mute); }
  .feat-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); flex-shrink: 0; box-shadow: 0 0 8px var(--accent);
  }
  .brand-footer { position: relative; z-index: 1; font-size: 11px; color: var(--ink-faint); letter-spacing: 0.03em; }

  /* ── Form panel ── */
  .form-panel {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 40px 24px; background: var(--bg);
  }
  .form-card {
    width: 100%; max-width: 360px;
    animation: authSlide 320ms cubic-bezier(.2,.7,.1,1) both;
  }
  @keyframes authSlide {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .form-header { margin-bottom: 32px; }
  .form-icon {
    width: 48px; height: 48px; border-radius: 12px;
    background: rgba(59,130,246,0.10);
    border: 1px solid rgba(59,130,246,0.20);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px; color: var(--accent);
  }
  .form-title { font-size: 22px; font-weight: 700; color: var(--ink); letter-spacing: -0.02em; margin-bottom: 8px; }
  .form-subtitle { font-size: 13px; color: var(--ink-mute); line-height: 1.55; }

  .form-body { display: flex; flex-direction: column; gap: 20px; }
  .field-group { display: flex; flex-direction: column; gap: 6px; }
  .field-label { font-size: 12px; font-weight: 500; color: var(--ink-mute); letter-spacing: 0.02em; }

  .error-banner {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 12px;
    background: rgba(248,113,113,0.07);
    border: 1px solid rgba(248,113,113,0.20);
    border-radius: 6px; font-size: 13px; color: #fca5a5;
  }
  .error-banner.hidden { display: none; }

  .submit-btn { width: 100%; height: 40px; justify-content: center; font-size: 13.5px; font-weight: 600; }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .spinner {
    width: 14px; height: 14px;
    border: 2px solid rgba(241,246,255,0.25); border-top-color: #f1f6ff;
    border-radius: 50%; animation: spin 600ms linear infinite; margin-left: 6px;
  }
  .spinner.hidden { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .success-icon {
    width: 64px; height: 64px; border-radius: 16px;
    background: rgba(74,222,128,0.08);
    border: 1px solid rgba(74,222,128,0.20);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 24px;
  }

  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 28px; font-size: 12.5px; color: var(--ink-mute);
    text-decoration: none; transition: color 150ms;
  }
  .back-link:hover { color: var(--ink); }

  #view-success.hidden, #view-form.hidden { display: none; }
</style>
