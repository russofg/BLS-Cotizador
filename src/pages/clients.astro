---
import Dashboard from "../layouts/Dashboard.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import StatCard from "../components/ui/StatCard.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import Input from "../components/ui/Input.astro";
import Select from "../components/ui/Select.astro";
import Textarea from "../components/ui/Textarea.astro";
import ScrollbarStyles from "../components/ScrollbarStyles.astro";
---

<Dashboard title="Clientes - BLS Cotizador" activeSection="clients">
  <ScrollbarStyles />
  <div class="space-y-6">
    <!-- Screen Header -->
    <section class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8">
      <div>
        <nav class="flex items-center gap-2 mb-2">
          <span class="text-[10px] font-bold tracking-widest text-[var(--color-on-surface-variant)] uppercase">Directorio</span>
          <span class="material-symbols-outlined text-xs text-[var(--color-outline)]">chevron_right</span>
          <span class="text-[10px] font-bold tracking-widest text-[var(--color-primary)] uppercase">Clientes Corporativos</span>
        </nav>
        <h2 class="text-4xl font-black tracking-tight text-[var(--color-on-surface)]">Portafolio de Clientes</h2>
        <p class="text-[var(--color-on-surface-variant)] mt-2 text-base">Gestione y rastree sus relaciones a nivel empresarial.</p>
      </div>
      <div class="flex items-center gap-3">
        <button id="refresh-btn" class="flex items-center gap-2 px-5 py-3 rounded-xl font-bold transition-all border border-[var(--color-outline-variant)] text-[var(--color-on-surface)] hover:bg-[var(--color-surface-container-high)] focus:ring-2 focus:ring-[var(--color-primary)]/50">
          <span class="material-symbols-outlined text-lg">refresh</span>
          Actualizar
        </button>
        <button id="add-client-btn" class="flex items-center gap-2 bg-gradient-to-br from-blue-500 to-blue-700 text-white px-6 py-3 rounded-xl font-bold shadow-[0_8px_16px_rgba(59,130,246,0.3)] transition-all hover:scale-[1.02] active:scale-[0.98] focus:ring-2 focus:ring-blue-500/50">
          <span class="material-symbols-outlined text-lg">person_add</span>
          Nuevo Cliente
        </button>
      </div>
    </section>

    <!-- Stats Grid (Stitch Editorial Shadows) -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      <div class="bg-[var(--color-surface-container-low)] p-6 rounded-xl border border-[var(--color-outline-variant)]/50 shadow-[0_12px_32px_rgba(0,0,0,0.4)]">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-on-surface-variant)] mb-1">Total Clientes</p>
        <h4 class="text-3xl font-black text-[var(--color-on-surface)] flex items-baseline gap-2">
            <span id="total-clients">0</span> <span class="text-sm font-medium text-[var(--color-on-surface-variant)]">Entidades</span>
        </h4>
        <p id="stats-scope-label" class="text-[10px] text-[var(--color-on-surface-variant)] mt-1 hidden">(de los cargados)</p>
      </div>
      <div class="bg-[var(--color-surface-container-low)] p-6 rounded-xl border border-[var(--color-outline-variant)]/50 shadow-[0_12px_32px_rgba(0,0,0,0.4)]">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-on-surface-variant)] mb-1">Clientes Activos</p>
        <h4 class="text-3xl font-black text-emerald-400 flex items-baseline gap-2">
            <span id="active-clients">0</span> <span class="text-sm font-medium text-[var(--color-on-surface-variant)]">Validados</span>
        </h4>
      </div>
      <div class="bg-[var(--color-surface-container-low)] p-6 rounded-xl border border-[var(--color-outline-variant)]/50 shadow-[0_12px_32px_rgba(0,0,0,0.4)]">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-on-surface-variant)] mb-1">Con Cotizaciones</p>
        <h4 class="text-3xl font-black text-blue-400 flex items-baseline gap-2">
            <span id="clients-with-quotes">0</span> <span class="text-sm font-medium text-[var(--color-on-surface-variant)]">Con historial</span>
        </h4>
      </div>
      <div class="bg-[var(--color-surface-container-low)] p-6 rounded-xl border border-[var(--color-outline-variant)]/50 shadow-[0_12px_32px_rgba(0,0,0,0.4)]">
        <p class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-on-surface-variant)] mb-1">Adjudicados (30 días)</p>
        <h4 class="text-3xl font-black text-amber-400 flex items-baseline gap-2">
            <span id="recent-clients">0</span> <span class="text-sm font-medium text-[var(--color-on-surface-variant)]">Nuevos</span>
        </h4>
      </div>
    </section>

    <!-- Filters -->
    <div class="bg-[var(--color-surface-container-low)]/50 p-6 rounded-xl border border-[var(--color-outline-variant)]/30 backdrop-blur-md mb-8 shadow-[0_8px_16px_rgba(0,0,0,0.2)]">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 items-end">
        <div>
          <Input id="search" placeholder="Buscar por nombre o empresa..." label="Buscar cliente" />
          <p class="text-[10px] text-[var(--color-on-surface-variant)] mt-1 ml-1">Búsqueda por inicio de nombre o empresa</p>
        </div>
        <Select
          id="status"
          label="Estado Comercial"
          options={[
            { value: "", label: "Cualquier estado" },
            { value: "active", label: "Activos" },
            { value: "inactive", label: "Inactivos" },
          ]}
        />
        <Input
          id="company"
          placeholder="Ej: Globant, Mercado Libre"
          label="Empresa"
        />
        <div class="flex space-x-2">
          <button id="clear-filters" class="w-full flex-1 py-3 px-4 rounded-xl font-bold bg-[var(--color-surface-container-high)] text-[var(--color-on-surface)] hover:bg-[var(--color-surface-container-highest)] border border-[var(--color-outline-variant)] transition-all focus:ring-2 focus:ring-[var(--color-primary)]/50">
            Limpiar Filtros
          </button>
        </div>
      </div>
    </div>

    <!-- Client Grid Container -->
    <section id="clients-grid" class="grid grid-cols-1 xl:grid-cols-2 gap-6 pb-6">
      <!-- Skeleton initial loading state -->
      <div id="skeleton-loader" class="xl:col-span-2 text-center py-20 text-[var(--color-on-surface-variant)]">
        <svg class="animate-spin h-10 w-10 mx-auto mb-4 text-[var(--color-primary)] opacity-80" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-sm font-bold uppercase tracking-widest text-slate-500">Cargando portafolio...</p>
      </div>
    </section>

    <!-- "Cargar más" button — outside the grid, shown only when hasMore === true -->
    <div id="load-more-container" class="hidden flex justify-center pb-12">
      <button
        id="load-more-btn"
        class="flex items-center gap-3 px-8 py-4 rounded-xl font-bold border border-[var(--color-outline-variant)] text-[var(--color-on-surface)] bg-[var(--color-surface-container-low)] hover:bg-[var(--color-surface-container-high)] transition-all focus:ring-2 focus:ring-[var(--color-primary)]/50 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="load-more-spinner" class="hidden">
          <svg class="animate-spin h-5 w-5 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
        <span class="material-symbols-outlined text-lg" id="load-more-icon">expand_more</span>
        <span id="load-more-text">Cargar más clientes</span>
      </button>
    </div>

    <!-- Client Modal -->
    <div
      id="client-modal"
      class="fixed inset-0 bg-slate-950/80 backdrop-blur-xl hidden overflow-y-auto h-full w-full z-50 transition-all duration-500"
    >
      <div class="relative top-5 sm:top-20 mx-auto p-0 border border-[var(--color-outline-variant)] w-11/12 sm:w-[450px] shadow-[0_24px_48px_rgba(0,0,0,0.6)] rounded-3xl bg-[var(--color-surface-container-low)] overflow-hidden anime-fade-in">
        <div class="px-8 py-6 bg-[var(--color-surface-container)] border-b border-[var(--color-outline-variant)] flex justify-between items-center">
          <h3
            class="text-2xl font-black text-white"
            id="modal-title"
          >
            Nuevo Cliente
          </h3>
          <button
            type="button"
            id="modal-close-btn"
            class="text-slate-400 hover:text-blue-400 transition-colors bg-slate-900/50 p-2 rounded-full"
            aria-label="Cerrar"
          >
            <span class="material-symbols-outlined text-lg block">close</span>
          </button>
        </div>

        <div class="p-8">
          <form id="client-form" class="space-y-5">

            <!-- Avatar Upload -->
            <div class="flex flex-col items-center gap-4">
              <div class="relative">
                <div
                  id="photo-preview-container"
                  class="relative w-24 h-24 rounded-2xl overflow-hidden border-2 border-dashed border-[var(--color-outline-variant)] bg-[var(--color-surface-container)] flex items-center justify-center cursor-pointer group hover:border-[var(--color-primary)] transition-all"
                >
                  <img
                    id="photo-preview"
                    src=""
                    alt="Preview"
                    class="absolute inset-0 w-full h-full object-cover hidden"
                  />
                  <div id="photo-placeholder" class="flex flex-col items-center gap-1 text-[var(--color-on-surface-variant)] group-hover:text-[var(--color-primary)] transition-colors">
                    <span class="material-symbols-outlined text-3xl">add_a_photo</span>
                    <span class="text-[10px] font-bold uppercase tracking-widest">Foto</span>
                  </div>
                  <input
                    id="client-foto"
                    type="file"
                    accept="image/*"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                  />
                </div>
                <!-- Remove photo button: only visible when there's a photo -->
                <button
                  type="button"
                  id="remove-photo-btn"
                  title="Quitar foto"
                  class="hidden absolute -top-2 -right-2 w-6 h-6 rounded-full bg-red-500 text-white flex items-center justify-center shadow-lg hover:bg-red-600 transition-colors z-10"
                >
                  <span class="material-symbols-outlined text-sm leading-none">close</span>
                </button>
              </div>
              <p class="text-[10px] text-[var(--color-on-surface-variant)] text-center">Foto de perfil (opcional)<br/>Se comprime automáticamente</p>
            </div>

            <Input id="client-nombre" required label="Nombre completo" placeholder="Ej: Juan Pérez" />
            <Input id="client-empresa" label="Empresa / Organización" placeholder="Opcional" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input id="client-email" type="email" label="Email" placeholder="juan@ejemplo.com" />
              <Input id="client-telefono" type="tel" label="Teléfono" placeholder="+54..." />
            </div>
            <Textarea id="client-direccion" rows={2} label="Dirección física" placeholder="Opcional" />

            <div class="flex items-center p-4 bg-surface-container-lowest rounded-xl border border-outline-variant/15 transition-all hover:bg-surface-container">
              <input
                id="client-activo"
                type="checkbox"
                checked
                class="h-5 w-5 text-primary-600 focus:ring-primary-500 border-gray-300 dark:border-gray-600 rounded-lg transition-all"
              />
              <label
                for="client-activo"
                class="ml-3 block text-sm font-bold text-gray-700 dark:text-gray-200 uppercase tracking-wider"
                >Cliente activo comercialmente</label
              >
            </div>
          </form>

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-3 gap-3 sm:gap-0 mt-8">
            <Button id="cancel-client-btn" variant="secondary" class="w-full sm:w-auto">
              Cancelar
            </Button>
            <Button id="save-client-btn" variant="primary" type="submit" class="w-full sm:w-auto">
              Guardar Cliente
            </Button>
          </div>
        </div>
      </div>
    </div>

    <!-- Loading Overlay -->
    <div
      id="loading-overlay"
      class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50"
    >
      <div
        class="bg-white dark:bg-gray-800 rounded-lg p-6 sm:p-8 max-w-sm w-full mx-4"
      >
        <div class="text-center">
          <svg
            class="animate-spin h-12 w-12 mx-auto mb-4 text-primary-600"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">
            Procesando...
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Conectando con Firebase
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { notifications } from "../utils/notifications.js";
    import {
      initialState,
      onLoadStart,
      onPageLoaded,
      onMoreLoaded,
      onFilterChange,
      onMutationSuccess,
      onFetchError,
      canLoadMore,
      type ClientsListState,
    } from "../utils/clientsListState";

    // ──────────────────────────────────────────────────────────────
    // State
    // ──────────────────────────────────────────────────────────────
    let state: ClientsListState = initialState();
    let editingClient: any = null;
    let currentImageBase64: string | null = null;
    let shouldRemovePhoto: boolean = false;
    let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

    // ──────────────────────────────────────────────────────────────
    // Derived filter helpers
    // ──────────────────────────────────────────────────────────────
    function buildApiUrl(cursor: string | null = null): string {
      const params = new URLSearchParams();
      params.set("includeQuoteCount", "true");
      params.set("pageSize", String(state.pageSize));

      if (state.search.trim()) {
        params.set("search", state.search.trim());
      }
      if (state.filters.activo === "active") {
        params.set("activo", "true");
      } else if (state.filters.activo === "inactive") {
        params.set("activo", "false");
      }
      if (state.filters.empresa && state.filters.empresa.trim()) {
        params.set("empresa", state.filters.empresa.trim());
      }
      if (cursor) {
        params.set("cursor", cursor);
      }

      return `/api/clients?${params.toString()}`;
    }

    // ──────────────────────────────────────────────────────────────
    // Photo utilities (unchanged from before)
    // ──────────────────────────────────────────────────────────────
    function syncRemoveBtn() {
      const btn = document.getElementById('remove-photo-btn') as HTMLButtonElement;
      const preview = document.getElementById('photo-preview') as HTMLImageElement;
      if (!btn) return;
      const hasPhoto = preview && !preview.classList.contains('hidden');
      if (hasPhoto) {
        btn.classList.remove('hidden');
        btn.classList.add('flex');
      } else {
        btn.classList.add('hidden');
        btn.classList.remove('flex');
      }
    }

    function resetPhotoUI() {
      currentImageBase64 = null;
      const preview = document.getElementById('photo-preview') as HTMLImageElement;
      const placeholder = document.getElementById('photo-placeholder') as HTMLDivElement;
      const fileInput = document.getElementById('client-foto') as HTMLInputElement;
      if (preview) { preview.src = ''; preview.classList.add('hidden'); }
      if (placeholder) placeholder.classList.remove('hidden');
      if (fileInput) fileInput.value = '';
      syncRemoveBtn();
    }

    function compressImage(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const MAX_SIZE = 256;
        const QUALITY = 0.8;
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (e) => {
          const img = new Image();
          img.src = e.target?.result as string;
          img.onload = () => {
            const canvas = document.createElement('canvas');
            let { width, height } = img;
            if (width > height) {
              if (width > MAX_SIZE) { height = (height * MAX_SIZE) / width; width = MAX_SIZE; }
            } else {
              if (height > MAX_SIZE) { width = (width * MAX_SIZE) / height; height = MAX_SIZE; }
            }
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d')!;
            ctx.drawImage(img, 0, 0, width, height);
            resolve(canvas.toDataURL('image/jpeg', QUALITY));
          };
          img.onerror = reject;
        };
        reader.onerror = reject;
      });
    }

    // ──────────────────────────────────────────────────────────────
    // Loading overlay (for modal save/delete operations)
    // ──────────────────────────────────────────────────────────────
    function showLoading() {
      const overlay = document.getElementById("loading-overlay");
      if (overlay) {
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
      }
    }

    function hideLoading() {
      const overlay = document.getElementById("loading-overlay");
      if (overlay) {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Skeleton loader (first page only)
    // ──────────────────────────────────────────────────────────────
    function showSkeleton() {
      const grid = document.getElementById("clients-grid");
      if (!grid) return;
      grid.innerHTML = `
        <div class="xl:col-span-2 text-center py-20 text-[var(--color-on-surface-variant)]">
          <svg class="animate-spin h-10 w-10 mx-auto mb-4 text-[var(--color-primary)] opacity-80" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-sm font-bold uppercase tracking-widest text-slate-500">Cargando portafolio...</p>
        </div>
      `;
    }

    // ──────────────────────────────────────────────────────────────
    // "Cargar más" button state
    // ──────────────────────────────────────────────────────────────
    function syncLoadMoreButton() {
      const container = document.getElementById("load-more-container");
      const btn = document.getElementById("load-more-btn") as HTMLButtonElement;
      const spinner = document.getElementById("load-more-spinner");
      const icon = document.getElementById("load-more-icon");
      const text = document.getElementById("load-more-text");

      if (!container || !btn) return;

      if (state.hasMore) {
        container.classList.remove("hidden");
      } else {
        container.classList.add("hidden");
      }

      if (state.isLoading && state.allClients.length > 0) {
        // "Cargar más" in progress
        btn.disabled = true;
        spinner?.classList.remove("hidden");
        icon?.classList.add("hidden");
        if (text) text.textContent = "Cargando...";
      } else {
        btn.disabled = false;
        spinner?.classList.add("hidden");
        icon?.classList.remove("hidden");
        if (text) text.textContent = "Cargar más clientes";
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Modal helpers
    // ──────────────────────────────────────────────────────────────
    function showModal() {
      document.getElementById("client-modal")?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        const firstInput = document.querySelector("#client-form input") as HTMLElement;
        firstInput?.focus();
      }, 100);
    }

    function hideModal() {
      document.getElementById("client-modal")?.classList.add("hidden");
      document.body.style.overflow = "";
      clearForm();
      editingClient = null;
    }

    function clearForm() {
      (document.getElementById("client-nombre") as HTMLInputElement).value = "";
      (document.getElementById("client-empresa") as HTMLInputElement).value = "";
      (document.getElementById("client-email") as HTMLInputElement).value = "";
      (document.getElementById("client-telefono") as HTMLInputElement).value = "";
      (document.getElementById("client-direccion") as HTMLTextAreaElement).value = "";
      (document.getElementById("client-activo") as HTMLInputElement).checked = true;
      shouldRemovePhoto = false;
      resetPhotoUI();
    }

    // ──────────────────────────────────────────────────────────────
    // Render clients grid
    // ──────────────────────────────────────────────────────────────
    function renderClients(clients: any[]) {
      const clientsGrid = document.getElementById("clients-grid");
      if (!clientsGrid) return;

      if (clients.length === 0) {
        clientsGrid.innerHTML = `
          <div class="xl:col-span-2 text-center py-20 text-[var(--color-on-surface-variant)] border border-dashed border-[var(--color-outline-variant)] rounded-2xl bg-[var(--color-surface-container-low)]">
            <span class="material-symbols-outlined text-5xl mb-4 opacity-50 block">sentiment_neutral</span>
            <h3 class="text-xl font-bold text-[var(--color-on-surface)] mb-2">Sin clientes encontrados</h3>
            <p class="text-[var(--color-on-surface-variant)] text-sm">Comienza agregando un cliente o cambia tus filtros de búsqueda.</p>
          </div>
        `;
        return;
      }

      clientsGrid.innerHTML = clients
        .map((client) => {
          const initials = client.nombre
            ? client.nombre
                .split(" ")
                .map((n: string) => n[0])
                .join("")
                .substring(0, 2)
                .toUpperCase()
            : "CL";

          const activeBadgeClass = client.activo
            ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
            : "bg-slate-500/10 text-slate-400 border-slate-500/20";
          const activeBadgeText = client.activo ? "Activo" : "Inactivo";

          const avatarHtml = client.imagenBase64
            ? `<img src="${client.imagenBase64}" alt="${client.nombre}" class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-2xl object-cover group-hover:scale-105 transition-transform border border-[var(--color-outline-variant)] shadow-[0_4px_12px_rgba(0,0,0,0.3)] grayscale-[20%] group-hover:grayscale-0 transition-all duration-500" />`
            : `<div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 rounded-2xl bg-gradient-to-br from-[var(--color-surface-container-highest)] to-[var(--color-surface-container)] flex items-center justify-center text-[var(--color-primary)] font-black text-2xl group-hover:scale-105 transition-transform border border-[var(--color-outline-variant)] shadow-inner">${initials}</div>`;

          return `
            <div class="bg-[var(--color-surface-container-low)] p-6 sm:p-8 rounded-xl border border-[var(--color-outline-variant)] shadow-[0_12px_32px_rgba(0,0,0,0.3)] hover:bg-[var(--color-surface-container)] transition-all group relative overflow-hidden">
              <a href="/clients/${client.id}" class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
                ${avatarHtml}
                <div class="flex-1 w-full text-center sm:text-left">
                  <div class="flex flex-col sm:flex-row justify-between items-center sm:items-start gap-3 sm:gap-0">
                    <div>
                      <h3 class="text-xl font-black text-[var(--color-on-surface)] group-hover:text-[var(--color-primary)] transition-colors">${client.nombre || "Sin nombre"}</h3>
                      <p class="text-[var(--color-primary)] font-bold text-sm tracking-wide opacity-80">${client.empresa || "Sin empresa"}</p>
                    </div>
                    <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-full border ${activeBadgeClass}">
                      ${activeBadgeText}
                    </span>
                  </div>
                  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex items-center gap-3 text-[var(--color-on-surface-variant)] justify-center sm:justify-start">
                      <span class="material-symbols-outlined text-sm opacity-70">mail</span>
                      <span class="text-xs truncate max-w-[140px]" title="${client.email || ''}">${client.email || "—"}</span>
                    </div>
                    <div class="flex items-center gap-3 text-[var(--color-on-surface-variant)] justify-center sm:justify-start">
                      <span class="material-symbols-outlined text-sm opacity-70">phone</span>
                      <span class="text-xs">${client.telefono || "—"}</span>
                    </div>
                  </div>
                </div>
              </a>
              <div class="mt-6 pt-5 border-t border-[var(--color-outline-variant)]/50 flex justify-between items-center w-full">
                <p class="text-[10px] font-black text-[var(--color-on-surface-variant)] uppercase tracking-widest">
                  ${client.cotizaciones || 0} Cotizaciones
                </p>
                <div class="flex items-center gap-4 opacity-50 sm:opacity-0 group-hover:opacity-100 transition-opacity">
                  <button class="edit-client flex items-center text-[var(--color-on-surface-variant)] hover:text-[var(--color-primary)] transition-colors" data-id="${client.id}" title="Editar Cliente">
                    <span class="material-symbols-outlined text-xl pointer-events-none">edit_document</span>
                  </button>
                  <button class="delete-client flex items-center text-[var(--color-on-surface-variant)] hover:text-red-500 transition-colors" data-id="${client.id}" title="Borrar Cliente">
                    <span class="material-symbols-outlined text-xl pointer-events-none">delete</span>
                  </button>
                </div>
              </div>
            </div>
          `;
        })
        .join("");

      // Re-attach event listeners after innerHTML replacement
      document.querySelectorAll(".edit-client").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const clientId = target?.getAttribute("data-id");
          if (clientId) editClient(clientId);
        });
      });

      document.querySelectorAll(".delete-client").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const clientId = target?.getAttribute("data-id");
          if (clientId) deleteClient(clientId);
        });
      });
    }

    // ──────────────────────────────────────────────────────────────
    // Stats — server-driven total + client-side derived stats
    // ──────────────────────────────────────────────────────────────
    async function loadServerStats() {
      try {
        const res = await fetch("/api/clients?stats=true");
        if (!res.ok) return;
        const stats = await res.json();
        document.getElementById("total-clients")!.textContent = stats.total.toString();
      } catch {
        // non-critical — page-scoped count already shown by updateStats()
      }
    }

    function updateStats() {
      const clients = state.allClients;
      const totalClients = clients.length;
      const activeClients = clients.filter((c) => c.activo).length;
      const clientsWithQuotes = clients.filter((c) => (c.cotizaciones || 0) > 0).length;
      const thirtyDaysAgo = new Date();
      thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

      const recentClients = clients.filter((c) => {
        if (!c.createdAt) return false;
        let d;
        if (typeof c.createdAt === "string") {
          d = new Date(c.createdAt);
        } else if (c.createdAt.seconds) {
          d = new Date(c.createdAt.seconds * 1000);
        } else {
          d = new Date(c.createdAt);
        }
        return d >= thirtyDaysAgo;
      }).length;

      document.getElementById("total-clients")!.textContent = totalClients.toString();
      document.getElementById("active-clients")!.textContent = activeClients.toString();
      document.getElementById("clients-with-quotes")!.textContent = clientsWithQuotes.toString();
      document.getElementById("recent-clients")!.textContent = recentClients.toString();

      const scopeLabel = document.getElementById("stats-scope-label");
      if (scopeLabel) scopeLabel.classList.add("hidden");
    }

    // ──────────────────────────────────────────────────────────────
    // Fetch helpers
    // ──────────────────────────────────────────────────────────────

    /**
     * Load first page. Replaces accumulated list.
     * Shows skeleton during load.
     */
    async function loadFirstPage() {
      state = onLoadStart(state);
      showSkeleton();
      syncLoadMoreButton();

      try {
        const response = await fetch(buildApiUrl(null));
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        state = onPageLoaded(state, {
          items: data.items ?? [],
          nextCursor: data.nextCursor ?? null,
          hasMore: data.hasMore ?? false,
          pageSize: data.pageSize ?? 25,
        });
      } catch (err) {
        state = onFetchError(state, err instanceof Error ? err.message : String(err));
        showFetchError(state.error!);
      }

      renderClients(state.allClients);
      updateStats();
      syncLoadMoreButton();
      loadServerStats();
    }

    /**
     * Load next page and append to accumulated list.
     */
    async function loadMorePage() {
      if (!canLoadMore(state)) return;

      const cursorToUse = state.nextCursor;
      state = onLoadStart(state);
      syncLoadMoreButton();

      try {
        const response = await fetch(buildApiUrl(cursorToUse));
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        state = onMoreLoaded(state, {
          items: data.items ?? [],
          nextCursor: data.nextCursor ?? null,
          hasMore: data.hasMore ?? false,
          pageSize: data.pageSize ?? 25,
        });
      } catch (err) {
        state = onFetchError(state, err instanceof Error ? err.message : String(err));
        notifications.error("Error al cargar más clientes", state.error ?? "");
      }

      // Always re-render full accumulated list (append is handled by state machine)
      renderClients(state.allClients);
      updateStats();
      syncLoadMoreButton();
    }

    function showFetchError(message: string) {
      const grid = document.getElementById("clients-grid");
      if (!grid) return;
      grid.innerHTML = `
        <div class="xl:col-span-2 text-center py-20 border border-dashed border-red-500/30 rounded-2xl bg-[var(--color-surface-container-low)]">
          <span class="material-symbols-outlined text-5xl mb-4 text-red-400 block">error</span>
          <h3 class="text-xl font-bold text-[var(--color-on-surface)] mb-2">Error al cargar clientes</h3>
          <p class="text-[var(--color-on-surface-variant)] text-sm mb-4">${message}</p>
          <button onclick="location.reload()" class="px-6 py-3 rounded-xl font-bold bg-red-500/10 text-red-400 border border-red-500/20 hover:bg-red-500/20 transition-all">
            Reintentar
          </button>
        </div>
      `;
    }

    // ──────────────────────────────────────────────────────────────
    // Filter / search (server-driven)
    // ──────────────────────────────────────────────────────────────
    function applyFiltersAndReload() {
      const search = (document.getElementById("search") as HTMLInputElement)?.value ?? "";
      const status = (document.getElementById("status") as HTMLSelectElement)?.value ?? "";
      const company = (document.getElementById("company") as HTMLInputElement)?.value ?? "";

      state = onFilterChange(state, { activo: status, empresa: company }, search);
      loadFirstPage();
    }

    function debouncedSearch() {
      if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(applyFiltersAndReload, 300);
    }

    // ──────────────────────────────────────────────────────────────
    // CRUD operations
    // ──────────────────────────────────────────────────────────────
    async function saveClient() {
      try {
        showLoading();

        const nombre = (document.getElementById("client-nombre") as HTMLInputElement).value;
        const empresa = (document.getElementById("client-empresa") as HTMLInputElement).value;
        const email = (document.getElementById("client-email") as HTMLInputElement).value;
        const telefono = (document.getElementById("client-telefono") as HTMLInputElement).value;
        const direccion = (document.getElementById("client-direccion") as HTMLTextAreaElement).value;
        const activo = (document.getElementById("client-activo") as HTMLInputElement).checked;

        const clientData: any = {
          nombre,
          empresa: empresa || "",
          email,
          telefono: telefono || "",
          direccion: direccion || "",
          activo,
          updatedAt: new Date(),
        };

        if (currentImageBase64) {
          clientData.imagenBase64 = currentImageBase64;
        } else if (shouldRemovePhoto) {
          clientData.imagenBase64 = null;
        } else if (editingClient && editingClient.imagenBase64) {
          clientData.imagenBase64 = editingClient.imagenBase64;
        }

        if (editingClient) {
          const response = await fetch(`/api/clients`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: editingClient.id, ...clientData }),
          });
          if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        } else {
          const response = await fetch("/api/clients", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(clientData),
          });
          if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        }

        const wasEditing = !!editingClient;
        hideModal();
        hideLoading();

        // Reset + refetch after mutation
        state = onMutationSuccess(state);
        await loadFirstPage();

        notifications.success(
          wasEditing ? "¡Cliente actualizado!" : "¡Cliente creado!",
          wasEditing
            ? "Los datos del cliente se han actualizado exitosamente"
            : "El nuevo cliente ha sido agregado al sistema"
        );
      } catch (error) {
        console.error("Error saving client:", error);
        notifications.error(
          "Error al guardar cliente",
          error instanceof Error ? error.message : String(error)
        );
        hideLoading();
      }
    }

    function editClient(clientId: string) {
      const client = state.allClients.find((c) => c.id === clientId);
      if (!client) return;

      editingClient = client;
      currentImageBase64 = null;

      (document.getElementById("client-nombre") as HTMLInputElement).value = client.nombre || "";
      (document.getElementById("client-empresa") as HTMLInputElement).value = client.empresa || "";
      (document.getElementById("client-email") as HTMLInputElement).value = client.email || "";
      (document.getElementById("client-telefono") as HTMLInputElement).value = client.telefono || "";
      (document.getElementById("client-direccion") as HTMLTextAreaElement).value = client.direccion || "";
      (document.getElementById("client-activo") as HTMLInputElement).checked = client.activo !== false;

      const preview = document.getElementById('photo-preview') as HTMLImageElement;
      const placeholder = document.getElementById('photo-placeholder') as HTMLDivElement;
      if (client.imagenBase64 && preview && placeholder) {
        preview.src = client.imagenBase64;
        preview.classList.remove('hidden');
        placeholder.classList.add('hidden');
      } else if (preview && placeholder) {
        preview.src = '';
        preview.classList.add('hidden');
        placeholder.classList.remove('hidden');
      }
      syncRemoveBtn();

      document.getElementById("modal-title")!.textContent = "Editar Cliente";
      showModal();
    }

    async function deleteClient(clientId: string) {
      const client = state.allClients.find((c) => c.id === clientId);
      const clientName = client ? `${client.nombre} - ${client.empresa}` : "este cliente";

      const result = await notifications.confirmDelete(clientName);
      if (!result.isConfirmed) return;

      try {
        notifications.loading("Eliminando cliente", "Por favor espera...");

        const response = await fetch("/api/clients", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: clientId }),
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error || `HTTP error! status: ${response.status}`);
        }

        // Reset + refetch after delete
        state = onMutationSuccess(state);
        await loadFirstPage();

        notifications.success("¡Cliente eliminado!", "El cliente ha sido eliminado exitosamente");
      } catch (error) {
        console.error("Error deleting client:", error);
        notifications.error(
          "Error al eliminar cliente",
          error instanceof Error ? error.message : String(error)
        );
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Bootstrap
    // ──────────────────────────────────────────────────────────────
    document.addEventListener("DOMContentLoaded", async () => {
      // Photo file input → compress → preview
      document.getElementById('client-foto')?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const base64 = await compressImage(file);
          currentImageBase64 = base64;
          shouldRemovePhoto = false;
          const preview = document.getElementById('photo-preview') as HTMLImageElement;
          const placeholder = document.getElementById('photo-placeholder') as HTMLDivElement;
          if (preview && placeholder) {
            preview.src = base64;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden');
          }
          syncRemoveBtn();
        } catch {
          notifications.error('Error', 'No se pudo procesar la imagen. Intenta con otra.');
        }
      });

      // Remove photo button
      document.getElementById('remove-photo-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        shouldRemovePhoto = true;
        resetPhotoUI();
      });

      // Initial load
      await loadFirstPage();

      // Search — debounced 300ms → server fetch with reset
      document.getElementById("search")?.addEventListener("input", debouncedSearch);

      // Status filter → immediate server fetch with reset
      document.getElementById("status")?.addEventListener("change", applyFiltersAndReload);

      // Company filter → immediate server fetch with reset
      document.getElementById("company")?.addEventListener("input", applyFiltersAndReload);

      // Clear filters
      document.getElementById("clear-filters")?.addEventListener("click", () => {
        (document.getElementById("search") as HTMLInputElement).value = "";
        (document.getElementById("status") as HTMLSelectElement).value = "";
        (document.getElementById("company") as HTMLInputElement).value = "";
        applyFiltersAndReload();
      });

      // Refresh button
      document.getElementById("refresh-btn")?.addEventListener("click", () => {
        state = onMutationSuccess(state);
        loadFirstPage();
      });

      // "Cargar más" button
      document.getElementById("load-more-btn")?.addEventListener("click", loadMorePage);

      // Add client
      document.getElementById("add-client-btn")?.addEventListener("click", () => {
        document.getElementById("modal-title")!.textContent = "Nuevo Cliente";
        showModal();
      });

      document.getElementById("cancel-client-btn")?.addEventListener("click", hideModal);
      document.getElementById("modal-close-btn")?.addEventListener("click", hideModal);
      document.getElementById("save-client-btn")?.addEventListener("click", saveClient);

      // Close modal when clicking backdrop
      document.getElementById("client-modal")?.addEventListener("click", (e) => {
        if (e.target === document.getElementById("client-modal")) hideModal();
      });

      // Handle URL params
      const urlParams = new URLSearchParams(window.location.search);

      const searchQuery = urlParams.get("search");
      if (searchQuery) {
        const searchInput = document.getElementById("search") as HTMLInputElement;
        if (searchInput) {
          searchInput.value = searchQuery;
          // Trigger server search with the pre-filled value
          applyFiltersAndReload();
        }
      }

      const editId = urlParams.get("edit");
      if (editId) {
        setTimeout(() => editClient(editId), 300);
      }
    });
  </script>
</Dashboard>
