---
import Dashboard from "../layouts/Dashboard.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import StatCard from "../components/ui/StatCard.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import Input from "../components/ui/Input.astro";
import Select from "../components/ui/Select.astro";
import Textarea from "../components/ui/Textarea.astro";
import ScrollbarStyles from "../components/ScrollbarStyles.astro";
---

<Dashboard title="Clientes - BLS Cotizador" activeSection="clients">
  <ScrollbarStyles />
  <div class="page-enter p-4 sm:p-8 space-y-4">

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <h1 class="text-[22px] font-semibold tracking-tightest text-ink">Clientes</h1>
        <p class="text-[13px] text-ink-mute mt-0.5">Gestión y seguimiento del directorio de clientes.</p>
      </div>
      <div class="flex items-center gap-2">
        <button id="refresh-btn" class="btn btn-ghost">
          <span class="material-symbols-rounded">refresh</span>
          Actualizar
        </button>
        <button id="add-client-btn" class="btn btn-primary">
          <span class="material-symbols-rounded">person_add</span>
          Nuevo Cliente
        </button>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Total Clientes</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-ink"><span id="total-clients">0</span></div>
        <p id="stats-scope-label" class="text-[10px] text-ink-faint mt-1 hidden">(de los cargados)</p>
        <div class="mt-2 text-[11.5px] text-ink-mute">entidades</div>
      </div>
      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Clientes Activos</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-ok"><span id="active-clients">0</span></div>
        <div class="mt-2 text-[11.5px] text-ink-mute">validados</div>
      </div>
      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Con Cotizaciones</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-accent"><span id="clients-with-quotes">0</span></div>
        <div class="mt-2 text-[11.5px] text-ink-mute">con historial</div>
      </div>
      <div class="surface p-4">
        <div class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Adjudicados (30 días)</div>
        <div class="mt-3 num text-[28px] font-semibold tracking-tight text-warn"><span id="recent-clients">0</span></div>
        <div class="mt-2 text-[11.5px] text-ink-mute">nuevos</div>
      </div>
    </div>

    <!-- Filters -->
    <div class="surface p-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 items-end">
        <div class="space-y-1">
          <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Buscar cliente</label>
          <input id="search" type="text" placeholder="Buscar por nombre o empresa..." class="field w-full" />
        </div>
        <div class="space-y-1">
          <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Estado Comercial</label>
          <div class="select-arrow">
            <select id="status" class="field w-full">
              <option value="">Cualquier estado</option>
              <option value="active">Activos</option>
              <option value="inactive">Inactivos</option>
            </select>
          </div>
        </div>
        <div class="space-y-1">
          <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Empresa</label>
          <input id="company" type="text" placeholder="Ej: Globant, Mercado Libre" class="field w-full" />
        </div>
        <div>
          <button id="clear-filters" class="btn btn-ghost w-full justify-center">
            Limpiar Filtros
          </button>
        </div>
      </div>
    </div>

    <!-- Clients grid / table container -->
    <section id="clients-grid" class="grid grid-cols-1 xl:grid-cols-2 gap-3 pb-4">
      <div id="skeleton-loader" class="xl:col-span-2 text-center py-16 text-ink-faint">
        <svg class="animate-spin h-8 w-8 mx-auto mb-3 text-accent opacity-80" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-[12px] uppercase tracking-[0.08em] text-ink-faint">Cargando portafolio...</p>
      </div>
    </section>

    <!-- "Cargar más" -->
    <div id="load-more-container" class="hidden flex justify-center pb-6">
      <button id="load-more-btn" class="btn btn-ghost disabled:opacity-50 disabled:cursor-not-allowed">
        <span id="load-more-spinner" class="hidden">
          <svg class="animate-spin h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
        <span class="material-symbols-rounded" id="load-more-icon">expand_more</span>
        <span id="load-more-text">Cargar más clientes</span>
      </button>
    </div>

    <!-- Client Modal -->
    <div
      id="client-modal"
      class="fixed inset-0 bg-bg-sunken/80 backdrop-blur-xl hidden overflow-y-auto h-full w-full z-50"
    >
      <div class="relative top-5 sm:top-16 mx-auto w-11/12 sm:w-[440px] surface shadow-[0_24px_48px_rgba(0,0,0,0.6)] overflow-hidden anime-fade-in">
        <div class="px-6 py-4 border-b border-line flex justify-between items-center">
          <h3 class="text-[16px] font-semibold text-ink" id="modal-title">Nuevo Cliente</h3>
          <button type="button" id="modal-close-btn" class="btn btn-icon btn-quiet" aria-label="Cerrar">
            <span class="material-symbols-rounded">close</span>
          </button>
        </div>

        <div class="p-6">
          <form id="client-form" class="space-y-4">

            <!-- Avatar Upload -->
            <div class="flex flex-col items-center gap-3">
              <div class="relative">
                <div
                  id="photo-preview-container"
                  class="relative w-20 h-20 rounded-xl overflow-hidden border border-dashed border-line bg-bg-sunken flex items-center justify-center cursor-pointer group hover:border-accent transition-all"
                >
                  <img id="photo-preview" src="" alt="Preview" class="absolute inset-0 w-full h-full object-cover hidden" />
                  <div id="photo-placeholder" class="flex flex-col items-center gap-1 text-ink-faint group-hover:text-accent transition-colors">
                    <span class="material-symbols-rounded text-[28px]">add_a_photo</span>
                    <span class="text-[10px] uppercase tracking-[0.06em]">Foto</span>
                  </div>
                  <input id="client-foto" type="file" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
                </div>
                <button type="button" id="remove-photo-btn" title="Quitar foto"
                  class="hidden absolute -top-2 -right-2 w-5 h-5 rounded-full bg-err text-bg flex items-center justify-center shadow z-10 hover:opacity-80 transition-opacity"
                >
                  <span class="material-symbols-rounded text-[12px] leading-none">close</span>
                </button>
              </div>
              <p class="text-[10px] text-ink-faint text-center">Foto de perfil opcional · Se comprime automáticamente</p>
            </div>

            <div class="space-y-1">
              <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Nombre completo *</label>
              <input id="client-nombre" type="text" required placeholder="Ej: Juan Pérez" class="field w-full" />
            </div>
            <div class="space-y-1">
              <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Empresa / Organización</label>
              <input id="client-empresa" type="text" placeholder="Opcional" class="field w-full" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="space-y-1">
                <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Email</label>
                <input id="client-email" type="email" placeholder="juan@ejemplo.com" class="field w-full" />
              </div>
              <div class="space-y-1">
                <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Teléfono</label>
                <input id="client-telefono" type="tel" placeholder="+54..." class="field w-full" />
              </div>
            </div>
            <div class="space-y-1">
              <label class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">Dirección física</label>
              <textarea id="client-direccion" rows="2" placeholder="Opcional" class="field w-full resize-none"></textarea>
            </div>

            <div class="flex items-center gap-3 p-3 rounded border border-line hover:border-accent/40 transition-all">
              <input id="client-activo" type="checkbox" checked class="w-4 h-4 accent-accent" />
              <label for="client-activo" class="text-[13px] text-ink cursor-pointer">Cliente activo comercialmente</label>
            </div>
          </form>

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-5">
            <button id="cancel-client-btn" class="btn btn-ghost w-full sm:w-auto">Cancelar</button>
            <button id="save-client-btn" class="btn btn-primary w-full sm:w-auto">Guardar Cliente</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loading-overlay" class="fixed inset-0 bg-bg/70 backdrop-blur-sm hidden items-center justify-center z-50">
      <div class="surface p-8 text-center space-y-3">
        <svg class="animate-spin h-10 w-10 mx-auto text-accent" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-[14px] font-semibold text-ink">Procesando...</p>
        <p class="text-[12px] text-ink-mute">Conectando con Firebase</p>
      </div>
    </div>
  </div>

  <script>
    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    import { notifications } from "../utils/notifications.js";
    import {
      initialState,
      onLoadStart,
      onPageLoaded,
      onMoreLoaded,
      onFilterChange,
      onMutationSuccess,
      onFetchError,
      canLoadMore,
      type ClientsListState,
    } from "../utils/clientsListState";

    // ──────────────────────────────────────────────────────────────
    // State
    // ──────────────────────────────────────────────────────────────
    let state: ClientsListState = initialState();
    let editingClient: any = null;
    let currentImageBase64: string | null = null;
    let shouldRemovePhoto: boolean = false;
    let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

    // ──────────────────────────────────────────────────────────────
    // Derived filter helpers
    // ──────────────────────────────────────────────────────────────
    function buildApiUrl(cursor: string | null = null): string {
      const params = new URLSearchParams();
      params.set("includeQuoteCount", "true");
      params.set("pageSize", String(state.pageSize));

      if (state.search.trim()) {
        params.set("search", state.search.trim());
      }
      if (state.filters.activo === "active") {
        params.set("activo", "true");
      } else if (state.filters.activo === "inactive") {
        params.set("activo", "false");
      }
      if (state.filters.empresa && state.filters.empresa.trim()) {
        params.set("empresa", state.filters.empresa.trim());
      }
      if (cursor) {
        params.set("cursor", cursor);
      }

      return `/api/clients?${params.toString()}`;
    }

    // ──────────────────────────────────────────────────────────────
    // Photo utilities (unchanged from before)
    // ──────────────────────────────────────────────────────────────
    function syncRemoveBtn() {
      const btn = document.getElementById('remove-photo-btn') as HTMLButtonElement;
      const preview = document.getElementById('photo-preview') as HTMLImageElement;
      if (!btn) return;
      const hasPhoto = preview && !preview.classList.contains('hidden');
      if (hasPhoto) {
        btn.classList.remove('hidden');
        btn.classList.add('flex');
      } else {
        btn.classList.add('hidden');
        btn.classList.remove('flex');
      }
    }

    function resetPhotoUI() {
      currentImageBase64 = null;
      const preview = document.getElementById('photo-preview') as HTMLImageElement;
      const placeholder = document.getElementById('photo-placeholder') as HTMLDivElement;
      const fileInput = document.getElementById('client-foto') as HTMLInputElement;
      if (preview) { preview.src = ''; preview.classList.add('hidden'); }
      if (placeholder) placeholder.classList.remove('hidden');
      if (fileInput) fileInput.value = '';
      syncRemoveBtn();
    }

    function compressImage(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const MAX_SIZE = 256;
        const QUALITY = 0.8;
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (e) => {
          const img = new Image();
          img.src = e.target?.result as string;
          img.onload = () => {
            const canvas = document.createElement('canvas');
            let { width, height } = img;
            if (width > height) {
              if (width > MAX_SIZE) { height = (height * MAX_SIZE) / width; width = MAX_SIZE; }
            } else {
              if (height > MAX_SIZE) { width = (width * MAX_SIZE) / height; height = MAX_SIZE; }
            }
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d')!;
            ctx.drawImage(img, 0, 0, width, height);
            resolve(canvas.toDataURL('image/jpeg', QUALITY));
          };
          img.onerror = reject;
        };
        reader.onerror = reject;
      });
    }

    // ──────────────────────────────────────────────────────────────
    // Loading overlay (for modal save/delete operations)
    // ──────────────────────────────────────────────────────────────
    function showLoading() {
      const overlay = document.getElementById("loading-overlay");
      if (overlay) {
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
      }
    }

    function hideLoading() {
      const overlay = document.getElementById("loading-overlay");
      if (overlay) {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Skeleton loader (first page only)
    // ──────────────────────────────────────────────────────────────
    function showSkeleton() {
      const grid = document.getElementById("clients-grid");
      if (!grid) return;
      grid.innerHTML = `
        <div class="xl:col-span-2 text-center py-16 text-ink-faint">
          <svg class="animate-spin h-8 w-8 mx-auto mb-3 text-accent opacity-80" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="text-[12px] uppercase tracking-[0.08em] text-ink-faint">Cargando portafolio...</p>
        </div>
      `;
    }

    // ──────────────────────────────────────────────────────────────
    // "Cargar más" button state
    // ──────────────────────────────────────────────────────────────
    function syncLoadMoreButton() {
      const container = document.getElementById("load-more-container");
      const btn = document.getElementById("load-more-btn") as HTMLButtonElement;
      const spinner = document.getElementById("load-more-spinner");
      const icon = document.getElementById("load-more-icon");
      const text = document.getElementById("load-more-text");

      if (!container || !btn) return;

      if (state.hasMore) {
        container.classList.remove("hidden");
      } else {
        container.classList.add("hidden");
      }

      if (state.isLoading && state.allClients.length > 0) {
        // "Cargar más" in progress
        btn.disabled = true;
        spinner?.classList.remove("hidden");
        icon?.classList.add("hidden");
        if (text) text.textContent = "Cargando...";
      } else {
        btn.disabled = false;
        spinner?.classList.add("hidden");
        icon?.classList.remove("hidden");
        if (text) text.textContent = "Cargar más clientes";
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Modal helpers
    // ──────────────────────────────────────────────────────────────
    function showModal() {
      document.getElementById("client-modal")?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        const firstInput = document.querySelector("#client-form input") as HTMLElement;
        firstInput?.focus();
      }, 100);
    }

    function hideModal() {
      document.getElementById("client-modal")?.classList.add("hidden");
      document.body.style.overflow = "";
      clearForm();
      editingClient = null;
    }

    function clearForm() {
      (document.getElementById("client-nombre") as HTMLInputElement).value = "";
      (document.getElementById("client-empresa") as HTMLInputElement).value = "";
      (document.getElementById("client-email") as HTMLInputElement).value = "";
      (document.getElementById("client-telefono") as HTMLInputElement).value = "";
      (document.getElementById("client-direccion") as HTMLTextAreaElement).value = "";
      (document.getElementById("client-activo") as HTMLInputElement).checked = true;
      shouldRemovePhoto = false;
      resetPhotoUI();
    }

    // ──────────────────────────────────────────────────────────────
    // Render clients grid
    // ──────────────────────────────────────────────────────────────
    function renderClients(clients: any[]) {
      const clientsGrid = document.getElementById("clients-grid");
      if (!clientsGrid) return;

      if (clients.length === 0) {
        clientsGrid.innerHTML = `
          <div class="xl:col-span-2 text-center py-16 surface">
            <span class="material-symbols-rounded text-[48px] text-ink-faint opacity-40 block mb-3">sentiment_neutral</span>
            <h3 class="text-[15px] font-semibold text-ink mb-1">Sin clientes encontrados</h3>
            <p class="text-[13px] text-ink-mute">Comenzá agregando un cliente o cambiá tus filtros.</p>
          </div>
        `;
        return;
      }

      clientsGrid.innerHTML = clients
        .map((client) => {
          const initials = client.nombre
            ? client.nombre
                .split(" ")
                .map((n: string) => n[0])
                .join("")
                .substring(0, 2)
                .toUpperCase()
            : "CL";

          const badgeClass = client.activo ? "badge-ok" : "badge-neutral";
          const badgeText = client.activo ? "Activo" : "Inactivo";

          const avatarHtml = client.imagenBase64
            ? `<img src="${client.imagenBase64}" alt="${client.nombre}" class="w-16 h-16 shrink-0 rounded-xl object-cover border border-line" />`
            : `<div class="w-16 h-16 shrink-0 rounded-xl bg-bg-sunken flex items-center justify-center text-accent font-semibold text-[18px] border border-line">${initials}</div>`;

          return `
            <div class="surface p-5 group transition-colors hover:border-line-strong">
              <a href="/clients/${client.id}" class="flex items-start gap-4">
                ${avatarHtml}
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                      <h3 class="text-[14px] font-semibold text-ink group-hover:text-accent transition-colors truncate">${escapeHtml(client.nombre || "Sin nombre")}</h3>
                      <p class="text-[12px] text-ink-mute truncate">${escapeHtml(client.empresa || "Sin empresa")}</p>
                    </div>
                    <span class="badge ${badgeClass} shrink-0"><span class="dot"></span>${badgeText}</span>
                  </div>
                  <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                    <div class="flex items-center gap-2 text-ink-mute">
                      <span class="material-symbols-rounded text-[14px]">mail</span>
                      <span class="text-[11px] truncate" title="${escapeHtml(client.email || '')}">${escapeHtml(client.email || "—")}</span>
                    </div>
                    <div class="flex items-center gap-2 text-ink-mute">
                      <span class="material-symbols-rounded text-[14px]">phone</span>
                      <span class="text-[11px]">${client.telefono || "—"}</span>
                    </div>
                  </div>
                </div>
              </a>
              <div class="mt-4 pt-3 border-t border-line flex items-center justify-between">
                <span class="text-[10px] uppercase tracking-[0.08em] text-ink-faint">
                  ${client.cotizaciones || 0} cotizaciones
                </span>
                <div class="row-actions flex items-center gap-1">
                  <button class="edit-client btn btn-icon btn-quiet" data-id="${client.id}" title="Editar Cliente">
                    <span class="material-symbols-rounded pointer-events-none">edit_document</span>
                  </button>
                  <button class="delete-client btn btn-icon btn-quiet hover:text-err" data-id="${client.id}" title="Borrar Cliente">
                    <span class="material-symbols-rounded pointer-events-none">delete</span>
                  </button>
                </div>
              </div>
            </div>
          `;
        })
        .join("");

      // Re-attach event listeners after innerHTML replacement
      document.querySelectorAll(".edit-client").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const clientId = target?.getAttribute("data-id");
          if (clientId) editClient(clientId);
        });
      });

      document.querySelectorAll(".delete-client").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const clientId = target?.getAttribute("data-id");
          if (clientId) deleteClient(clientId);
        });
      });
    }

    // ──────────────────────────────────────────────────────────────
    // Stats — server-driven total + client-side derived stats
    // ──────────────────────────────────────────────────────────────
    async function loadServerStats() {
      try {
        const res = await fetch("/api/clients?stats=true");
        if (!res.ok) return;
        const stats = await res.json();
        document.getElementById("total-clients")!.textContent = stats.total.toString();
      } catch {
        // non-critical — page-scoped count already shown by updateStats()
      }
    }

    function updateStats() {
      const clients = state.allClients;
      const totalClients = clients.length;
      const activeClients = clients.filter((c) => c.activo).length;
      const clientsWithQuotes = clients.filter((c) => (c.cotizaciones || 0) > 0).length;
      const thirtyDaysAgo = new Date();
      thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

      const recentClients = clients.filter((c) => {
        if (!c.createdAt) return false;
        let d;
        if (typeof c.createdAt === "string") {
          d = new Date(c.createdAt);
        } else if (c.createdAt.seconds) {
          d = new Date(c.createdAt.seconds * 1000);
        } else {
          d = new Date(c.createdAt);
        }
        return d >= thirtyDaysAgo;
      }).length;

      document.getElementById("total-clients")!.textContent = totalClients.toString();
      document.getElementById("active-clients")!.textContent = activeClients.toString();
      document.getElementById("clients-with-quotes")!.textContent = clientsWithQuotes.toString();
      document.getElementById("recent-clients")!.textContent = recentClients.toString();

      const scopeLabel = document.getElementById("stats-scope-label");
      if (scopeLabel) scopeLabel.classList.add("hidden");
    }

    // ──────────────────────────────────────────────────────────────
    // Fetch helpers
    // ──────────────────────────────────────────────────────────────

    /**
     * Load first page. Replaces accumulated list.
     * Shows skeleton during load.
     */
    async function loadFirstPage() {
      state = onLoadStart(state);
      showSkeleton();
      syncLoadMoreButton();

      try {
        const response = await fetch(buildApiUrl(null));
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        state = onPageLoaded(state, {
          items: data.items ?? [],
          nextCursor: data.nextCursor ?? null,
          hasMore: data.hasMore ?? false,
          pageSize: data.pageSize ?? 25,
        });
      } catch (err) {
        state = onFetchError(state, err instanceof Error ? err.message : String(err));
        showFetchError(state.error!);
      }

      renderClients(state.allClients);
      updateStats();
      syncLoadMoreButton();
      loadServerStats();
    }

    /**
     * Load next page and append to accumulated list.
     */
    async function loadMorePage() {
      if (!canLoadMore(state)) return;

      const cursorToUse = state.nextCursor;
      state = onLoadStart(state);
      syncLoadMoreButton();

      try {
        const response = await fetch(buildApiUrl(cursorToUse));
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        state = onMoreLoaded(state, {
          items: data.items ?? [],
          nextCursor: data.nextCursor ?? null,
          hasMore: data.hasMore ?? false,
          pageSize: data.pageSize ?? 25,
        });
      } catch (err) {
        state = onFetchError(state, err instanceof Error ? err.message : String(err));
        notifications.error("Error al cargar más clientes", state.error ?? "");
      }

      // Always re-render full accumulated list (append is handled by state machine)
      renderClients(state.allClients);
      updateStats();
      syncLoadMoreButton();
    }

    function showFetchError(message: string) {
      const grid = document.getElementById("clients-grid");
      if (!grid) return;
      grid.innerHTML = `
        <div class="xl:col-span-2 text-center py-16 surface">
          <span class="material-symbols-rounded text-[48px] text-err block mb-3">error</span>
          <h3 class="text-[15px] font-semibold text-ink mb-1">Error al cargar clientes</h3>
          <p class="text-[13px] text-ink-mute mb-4">${message}</p>
          <button onclick="location.reload()" class="btn btn-ghost">Reintentar</button>
        </div>
      `;
    }

    // ──────────────────────────────────────────────────────────────
    // Filter / search (server-driven)
    // ──────────────────────────────────────────────────────────────
    function applyFiltersAndReload() {
      const search = (document.getElementById("search") as HTMLInputElement)?.value ?? "";
      const status = (document.getElementById("status") as HTMLSelectElement)?.value ?? "";
      const company = (document.getElementById("company") as HTMLInputElement)?.value ?? "";

      state = onFilterChange(state, { activo: status, empresa: company }, search);
      loadFirstPage();
    }

    function debouncedSearch() {
      if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(applyFiltersAndReload, 300);
    }

    // ──────────────────────────────────────────────────────────────
    // CRUD operations
    // ──────────────────────────────────────────────────────────────
    async function saveClient() {
      try {
        showLoading();

        const nombre = (document.getElementById("client-nombre") as HTMLInputElement).value;
        const empresa = (document.getElementById("client-empresa") as HTMLInputElement).value;
        const email = (document.getElementById("client-email") as HTMLInputElement).value;
        const telefono = (document.getElementById("client-telefono") as HTMLInputElement).value;
        const direccion = (document.getElementById("client-direccion") as HTMLTextAreaElement).value;
        const activo = (document.getElementById("client-activo") as HTMLInputElement).checked;

        const clientData: any = {
          nombre,
          empresa: empresa || "",
          email,
          telefono: telefono || "",
          direccion: direccion || "",
          activo,
          updatedAt: new Date(),
        };

        if (currentImageBase64) {
          clientData.imagenBase64 = currentImageBase64;
        } else if (shouldRemovePhoto) {
          clientData.imagenBase64 = null;
        } else if (editingClient && editingClient.imagenBase64) {
          clientData.imagenBase64 = editingClient.imagenBase64;
        }

        if (editingClient) {
          const response = await fetch(`/api/clients`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: editingClient.id, ...clientData }),
          });
          if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        } else {
          const response = await fetch("/api/clients", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(clientData),
          });
          if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        }

        const wasEditing = !!editingClient;
        hideModal();
        hideLoading();

        // Reset + refetch after mutation
        state = onMutationSuccess(state);
        await loadFirstPage();

        notifications.success(
          wasEditing ? "¡Cliente actualizado!" : "¡Cliente creado!",
          wasEditing
            ? "Los datos del cliente se han actualizado exitosamente"
            : "El nuevo cliente ha sido agregado al sistema"
        );
      } catch (error) {
        console.error("Error saving client:", error);
        notifications.error(
          "Error al guardar cliente",
          error instanceof Error ? error.message : String(error)
        );
        hideLoading();
      }
    }

    function editClient(clientId: string) {
      const client = state.allClients.find((c) => c.id === clientId);
      if (!client) return;

      editingClient = client;
      currentImageBase64 = null;

      (document.getElementById("client-nombre") as HTMLInputElement).value = client.nombre || "";
      (document.getElementById("client-empresa") as HTMLInputElement).value = client.empresa || "";
      (document.getElementById("client-email") as HTMLInputElement).value = client.email || "";
      (document.getElementById("client-telefono") as HTMLInputElement).value = client.telefono || "";
      (document.getElementById("client-direccion") as HTMLTextAreaElement).value = client.direccion || "";
      (document.getElementById("client-activo") as HTMLInputElement).checked = client.activo !== false;

      const preview = document.getElementById('photo-preview') as HTMLImageElement;
      const placeholder = document.getElementById('photo-placeholder') as HTMLDivElement;
      if (client.imagenBase64 && preview && placeholder) {
        preview.src = client.imagenBase64;
        preview.classList.remove('hidden');
        placeholder.classList.add('hidden');
      } else if (preview && placeholder) {
        preview.src = '';
        preview.classList.add('hidden');
        placeholder.classList.remove('hidden');
      }
      syncRemoveBtn();

      document.getElementById("modal-title")!.textContent = "Editar Cliente";
      showModal();
    }

    async function deleteClient(clientId: string) {
      const client = state.allClients.find((c) => c.id === clientId);
      const clientName = client ? `${client.nombre} - ${client.empresa}` : "este cliente";

      const result = await notifications.confirmDelete(clientName);
      if (!result.isConfirmed) return;

      try {
        notifications.loading("Eliminando cliente", "Por favor espera...");

        const response = await fetch("/api/clients", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: clientId }),
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error || `HTTP error! status: ${response.status}`);
        }

        // Reset + refetch after delete
        state = onMutationSuccess(state);
        await loadFirstPage();

        notifications.success("¡Cliente eliminado!", "El cliente ha sido eliminado exitosamente");
      } catch (error) {
        console.error("Error deleting client:", error);
        notifications.error(
          "Error al eliminar cliente",
          error instanceof Error ? error.message : String(error)
        );
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Bootstrap
    // ──────────────────────────────────────────────────────────────
    document.addEventListener("DOMContentLoaded", async () => {
      // Photo file input → compress → preview
      document.getElementById('client-foto')?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          const base64 = await compressImage(file);
          currentImageBase64 = base64;
          shouldRemovePhoto = false;
          const preview = document.getElementById('photo-preview') as HTMLImageElement;
          const placeholder = document.getElementById('photo-placeholder') as HTMLDivElement;
          if (preview && placeholder) {
            preview.src = base64;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden');
          }
          syncRemoveBtn();
        } catch {
          notifications.error('Error', 'No se pudo procesar la imagen. Intenta con otra.');
        }
      });

      // Remove photo button
      document.getElementById('remove-photo-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        shouldRemovePhoto = true;
        resetPhotoUI();
      });

      // Initial load
      await loadFirstPage();

      // Search — debounced 300ms → server fetch with reset
      document.getElementById("search")?.addEventListener("input", debouncedSearch);

      // Status filter → immediate server fetch with reset
      document.getElementById("status")?.addEventListener("change", applyFiltersAndReload);

      // Company filter → immediate server fetch with reset
      document.getElementById("company")?.addEventListener("input", applyFiltersAndReload);

      // Clear filters
      document.getElementById("clear-filters")?.addEventListener("click", () => {
        (document.getElementById("search") as HTMLInputElement).value = "";
        (document.getElementById("status") as HTMLSelectElement).value = "";
        (document.getElementById("company") as HTMLInputElement).value = "";
        applyFiltersAndReload();
      });

      // Refresh button
      document.getElementById("refresh-btn")?.addEventListener("click", () => {
        state = onMutationSuccess(state);
        loadFirstPage();
      });

      // "Cargar más" button
      document.getElementById("load-more-btn")?.addEventListener("click", loadMorePage);

      // Add client
      document.getElementById("add-client-btn")?.addEventListener("click", () => {
        document.getElementById("modal-title")!.textContent = "Nuevo Cliente";
        showModal();
      });

      document.getElementById("cancel-client-btn")?.addEventListener("click", hideModal);
      document.getElementById("modal-close-btn")?.addEventListener("click", hideModal);
      document.getElementById("save-client-btn")?.addEventListener("click", saveClient);

      // Close modal when clicking backdrop
      document.getElementById("client-modal")?.addEventListener("click", (e) => {
        if (e.target === document.getElementById("client-modal")) hideModal();
      });

      // Handle URL params
      const urlParams = new URLSearchParams(window.location.search);

      const searchQuery = urlParams.get("search");
      if (searchQuery) {
        const searchInput = document.getElementById("search") as HTMLInputElement;
        if (searchInput) {
          searchInput.value = searchQuery;
          // Trigger server search with the pre-filled value
          applyFiltersAndReload();
        }
      }

      const editId = urlParams.get("edit");
      if (editId) {
        setTimeout(() => editClient(editId), 300);
      }
    });
  </script>
</Dashboard>
