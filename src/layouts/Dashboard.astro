---
import Base from "./Base.astro";

interface Props {
  title: string;
  activeSection?: string;
}

const { title, activeSection } = Astro.props;

const navItems = [
  { id: "dashboard",    label: "Dashboard",    icon: "space_dashboard" },
  { id: "quotes",       label: "Cotizaciones", icon: "description" },
  { id: "clients",      label: "Clientes",     icon: "groups" },
  { id: "items",        label: "Ítems",        icon: "inventory_2" },
];
const secondaryItems = [
  { id: "config",       label: "Configuración", icon: "tune" },
];
---

<Base title={title}>
  <div id="app-shell" class="min-h-screen">

    <!-- Drawer scrim (mobile) -->
    <div id="drawer-scrim" class="drawer-scrim fixed inset-0 z-30 bg-black/60 lg:hidden"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="drawer fixed inset-y-0 left-0 w-[240px] bg-bg-sidebar border-r border-line flex flex-col z-40">

      <!-- Brand -->
      <div class="px-4 pt-4 pb-3 border-b border-line">
        <div class="flex items-center gap-2.5">
          <div class="relative w-7 h-7 rounded-md flex items-center justify-center"
               style="background: linear-gradient(135deg, #1f2a44, #0c1424); border: 1px solid var(--line-strong)">
            <img src="/logo.svg" alt="" class="w-4 h-4" />
            <span class="absolute -bottom-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-ok"></span>
          </div>
          <div class="leading-tight">
            <div class="text-[13px] font-semibold tracking-tight text-ink">BLS Cotizador</div>
            <div class="text-[9.5px] uppercase tracking-microcaps text-ink-faint">Audiovisual</div>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 px-2 py-3 overflow-y-auto no-scrollbar">
        <div class="px-2 pb-1.5 text-[9.5px] uppercase tracking-microcaps text-ink-faint">Operaciones</div>
        <div class="flex flex-col gap-0.5">
          {navItems.map(item => (
            <a
              href={`/${item.id === "dashboard" ? "dashboard" : item.id === "quotes" ? "quotes" : item.id === "clients" ? "clients" : "items"}`}
              class={`nav-item ${activeSection === item.id ? "active nav-active" : ""}`}
            >
              <span class={`material-symbols-rounded ms-sm ${activeSection === item.id ? "text-accent" : "text-ink-faint"}`}>
                {item.icon}
              </span>
              <span>{item.label}</span>
            </a>
          ))}
        </div>

        <div class="px-2 pt-5 pb-1.5 text-[9.5px] uppercase tracking-microcaps text-ink-faint">Sistema</div>
        <div class="flex flex-col gap-0.5">
          {secondaryItems.map(item => (
            <a
              href={`/${item.id}`}
              class={`nav-item ${activeSection === item.id ? "active nav-active" : ""}`}
            >
              <span class={`material-symbols-rounded ms-sm ${activeSection === item.id ? "text-accent" : "text-ink-faint"}`}>
                {item.icon}
              </span>
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </nav>

      <!-- Footer CTA -->
      <div class="border-t border-line p-3">
        <a href="/quotes/new" class="btn btn-primary w-full justify-center">
          <span class="material-symbols-rounded ms-sm">add</span>
          <span>Nueva Cotización</span>
        </a>
      </div>
    </aside>

    <!-- Main -->
    <div class="lg:ml-[240px] min-h-screen flex flex-col">

      <!-- Header -->
      <header class="header-edge sticky top-0 z-20">
        <div class="px-4 sm:px-7 py-3 flex items-center gap-2 sm:gap-3">

          <!-- Mobile hamburger -->
          <button id="hamburger" class="hamburger-btn btn btn-ghost btn-icon btn-sm flex-shrink-0" aria-label="Abrir menú">
            <span class="material-symbols-rounded ms-sm">menu</span>
          </button>

          <!-- Title area -->
          <div class="flex-1 min-w-0">
            <h1 class="text-[15px] sm:text-[18px] font-semibold tracking-tightest truncate text-ink">{title.replace(' - BLS Cotizador', '')}</h1>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-1">
            <div id="notification-wrapper" class="relative">
              <button id="notification-button" class="btn btn-ghost btn-icon btn-sm" data-tip="Recordatorios">
                <span class="material-symbols-rounded ms-sm">notifications</span>
                <span id="notification-badge" class="hidden absolute top-1 right-1 w-1.5 h-1.5 rounded-full bg-err"></span>
              </button>
              <!-- Notifications dropdown -->
              <div id="notifications-menu" class="hidden absolute right-0 top-11 w-72 surface z-50 overflow-hidden"
                   style="box-shadow: 0 16px 40px -12px rgba(0,0,0,0.6)">
                <div class="px-4 py-2.5 border-b border-line flex items-center justify-between">
                  <span class="text-[9.5px] uppercase tracking-microcaps text-ink-faint font-medium">Recordatorios</span>
                  <span id="notification-count" class="num text-[10px] bg-accent-wash text-accent px-1.5 py-0.5 rounded font-medium">0</span>
                </div>
                <div id="notification-items-container" class="max-h-60 overflow-y-auto py-1">
                  <div class="px-4 py-6 text-center text-ink-faint text-[12px]">Sin recordatorios hoy</div>
                </div>
                <div class="p-2 border-t border-line">
                  <a href="/quotes" class="block w-full text-center py-1.5 text-[10px] font-medium text-accent hover:text-accent/80 transition-colors uppercase tracking-microcaps">
                    Ver todo el historial
                  </a>
                </div>
              </div>
            </div>

            <span class="inline-block w-px h-5 bg-line mx-0.5"></span>

            <!-- User menu -->
            <div class="relative">
              <button id="user-menu-button" class="flex items-center gap-1.5 px-1.5 py-1 rounded-md hover:bg-white/3 transition-colors">
                <div id="user-avatar-initials"
                     class="w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-bold num text-ink"
                     style="background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(59,130,246,0.05)); border: 1px solid var(--line-strong)">
                  U
                </div>
                <img id="user-avatar-image" class="w-6 h-6 rounded-md object-cover hidden" alt="" />
                <span id="user-display-name" class="hidden sm:inline text-[12px] font-medium text-ink">Usuario</span>
                <span class="material-symbols-rounded ms-sm text-ink-faint hidden sm:inline">expand_more</span>
              </button>

              <div id="user-menu" class="hidden absolute right-0 top-10 w-52 surface z-50 py-1 overflow-hidden"
                   style="box-shadow: 0 16px 40px -12px rgba(0,0,0,0.6)">
                <div class="px-3 py-2.5 border-b border-line">
                  <p class="text-[13px] font-semibold text-ink truncate" id="user-name-menu">Usuario</p>
                  <p class="text-[11px] text-ink-faint truncate mt-0.5" id="user-email">—</p>
                </div>
                <a href="/profile" class="flex items-center gap-2 px-3 py-2 text-[12px] text-ink-mute hover:bg-white/3 hover:text-ink transition-colors">
                  <span class="material-symbols-rounded ms-sm">person</span> Mi perfil
                </a>
                <a href="/config" class="flex items-center gap-2 px-3 py-2 text-[12px] text-ink-mute hover:bg-white/3 hover:text-ink transition-colors">
                  <span class="material-symbols-rounded ms-sm">tune</span> Configuración
                </a>
                <div class="border-t border-line mt-1 pt-1">
                  <button id="logout-button" class="flex items-center gap-2 w-full px-3 py-2 text-[12px] font-medium text-err hover:bg-err/5 transition-colors">
                    <span class="material-symbols-rounded ms-sm">logout</span> Cerrar sesión
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Page content -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8 page-enter">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="px-6 sm:px-8 py-4 border-t border-line flex items-center justify-between opacity-40">
        <p class="text-[10.5px] text-ink-faint">© 2024 BLS Cotizador · Audiovisuales</p>
        <p class="text-[10.5px] num text-ink-faint hidden sm:block">v2.4</p>
      </footer>
    </div>
  </div>
</Base>

<div id="notification-container" class="fixed top-4 right-4 z-50 space-y-2 pointer-events-none"></div>

<script>
  import { authService } from "../utils/auth";
  import { notifications } from "../utils/notifications.js";

  // ── Drawer (mobile) ──
  const hamburger = document.getElementById("hamburger");
  const sidebar   = document.getElementById("sidebar");
  const scrim     = document.getElementById("drawer-scrim");

  function openDrawer() {
    sidebar?.classList.add("open");
    scrim?.classList.add("open");
  }
  function closeDrawer() {
    sidebar?.classList.remove("open");
    scrim?.classList.remove("open");
  }
  hamburger?.addEventListener("click", openDrawer);
  scrim?.addEventListener("click", closeDrawer);

  // Close drawer when a nav link is clicked on mobile
  sidebar?.querySelectorAll("a").forEach(a => a.addEventListener("click", () => {
    if (window.innerWidth < 1024) closeDrawer();
  }));

  // ── User menu ──
  const userBtn  = document.getElementById("user-menu-button");
  const userMenu = document.getElementById("user-menu");

  userBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    userMenu?.classList.toggle("hidden");
  });
  document.addEventListener("click", (e) => {
    if (!userBtn?.contains(e.target as Node) && !userMenu?.contains(e.target as Node)) {
      userMenu?.classList.add("hidden");
    }
  });

  // ── Auth / user info ──
  function generateInitials(name: string): string {
    if (!name) return "U";
    const words = name.trim().split(/\s+/);
    return words.length >= 2
      ? (words[0][0] + words[1][0]).toUpperCase()
      : words[0].slice(0, 2).toUpperCase();
  }

  function updateAvatar(user: any) {
    const initials = document.getElementById("user-avatar-initials");
    const image    = document.getElementById("user-avatar-image") as HTMLImageElement;
    if (!initials || !image) return;
    if (user.avatar) {
      image.src = user.avatar;
      image.classList.remove("hidden");
      initials.classList.add("hidden");
    } else {
      image.classList.add("hidden");
      initials.classList.remove("hidden");
      initials.textContent = generateInitials(user.nombre || user.email);
    }
  }

  async function loadUser(retries = 3) {
    try {
      const user = await authService.getCurrentUser();
      if (user) {
        const nameEl  = document.getElementById("user-display-name");
        const nameMenu = document.getElementById("user-name-menu");
        const emailEl = document.getElementById("user-email");
        if (nameEl)   nameEl.textContent  = user.nombre || "Usuario";
        if (nameMenu) nameMenu.textContent = user.nombre || "Usuario";
        if (emailEl)  emailEl.textContent  = user.email  || "";
        updateAvatar(user);
      } else if (retries > 0) {
        setTimeout(() => loadUser(retries - 1), 500);
      }
    } catch {
      if (retries > 0) setTimeout(() => loadUser(retries - 1), 500);
    }
  }

  authService.onAuthStateChange(async (user) => {
    if (user) setTimeout(async () => {
      const u = await authService.getCurrentUser();
      if (u) {
        const nameEl   = document.getElementById("user-display-name");
        const nameMenu = document.getElementById("user-name-menu");
        const emailEl  = document.getElementById("user-email");
        if (nameEl)   nameEl.textContent  = u.nombre || "Usuario";
        if (nameMenu) nameMenu.textContent = u.nombre || "Usuario";
        if (emailEl)  emailEl.textContent  = u.email  || "";
        updateAvatar(u);
      }
    }, 1000);
  });

  window.addEventListener("avatarUpdated", (e: any) => updateAvatar(e.detail.user));
  await loadUser();

  // ── Logout ──
  document.getElementById("logout-button")?.addEventListener("click", async () => {
    const result = await notifications.confirm(
      "Cerrar sesión", "¿Estás seguro que deseas salir?",
      "Sí, cerrar sesión", "Cancelar"
    );
    if (result.isConfirmed) {
      notifications.loading("Cerrando sesión", "Por favor espera...");
      await authService.signOut();
      notifications.success("¡Hasta luego!", "Sesión cerrada exitosamente");
      setTimeout(() => { window.location.href = "/login"; }, 1000);
    }
  });

  // ── Notifications dropdown ──
  const notifBtn  = document.getElementById("notification-button");
  const notifMenu = document.getElementById("notifications-menu");

  notifBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    notifMenu?.classList.toggle("hidden");
    userMenu?.classList.add("hidden");
  });
  document.addEventListener("click", (e) => {
    if (!notifBtn?.contains(e.target as Node) && !notifMenu?.contains(e.target as Node)) {
      notifMenu?.classList.add("hidden");
    }
  });

  // ── Reminder checks ──
  async function checkReminders() {
    try {
      const res = await fetch("/api/quote-tracking?action=stats");
      if (!res.ok) return;
      const stats = await res.json();
      const badge     = document.getElementById("notification-badge");
      const count     = document.getElementById("notification-count");
      const container = document.getElementById("notification-items-container");

      if (stats.seguimientosPendientes?.length > 0) {
        const items = stats.seguimientosPendientes;
        badge?.classList.remove("hidden");
        if (count) count.textContent = items.length.toString();
        if (container) {
          container.innerHTML = items.map((s: any) => `
            <a href="/quotes/tracking/${s.id}" class="block px-4 py-2.5 hover:bg-white/3 transition-colors border-b border-line last:border-0">
              <div class="flex justify-between items-start mb-0.5">
                <span class="num text-[10px] text-accent">${s.numero}</span>
                <span class="text-[9px] text-ink-faint">${new Date(s.proximoSeguimiento).toLocaleDateString()}</span>
              </div>
              <p class="text-[12px] text-ink font-medium truncate">${s.clienteNombre}</p>
              <p class="text-[11px] text-ink-mute truncate mt-0.5">${s.proximoSeguimientoMensaje || 'Sin mensaje'}</p>
            </a>
          `).join('');
        }
      } else {
        badge?.classList.add("hidden");
        if (count) count.textContent = "0";
        if (container) container.innerHTML = '<div class="px-4 py-6 text-center text-ink-faint text-[12px]">Sin recordatorios hoy</div>';
      }
    } catch { /* silent */ }
  }

  setTimeout(checkReminders, 2000);
  setInterval(checkReminders, 5 * 60 * 1000);
</script>
